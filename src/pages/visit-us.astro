---
import { Image } from 'astro:assets';
import ContentPage from '../layouts/ContentPage.astro';
import HoursCard from '../components/HoursCard.astro';
import { site, upcomingSpecialHours, specialRows } from '../data/site';
import shopfront from '../assets/images/shopfront.jpg';
import scriptsCounter from '../assets/images/scripts-in-counter.jpg';
import dispensaryCounter from '../assets/images/jason-dispensary-counter.jpg';
import beautyAisle from '../assets/images/beauty-aisle.jpg';
import fragranceCabinets from '../assets/images/fragrance-cabinets.jpg';
import helpMedicalEntrance from '../assets/images/help-medical-entrance.jpg';
import prescriptionsAdvice from '../assets/images/prescriptions-and-advice.jpg';
import { liveArticleSlugs } from '../lib/articles';
// Links to scheduled articles appear with the Monday rebuild that publishes them
const live = await liveArticleSlugs();
const gallery = [
  { src: prescriptionsAdvice, alt: 'Aisles inside Priceline Pharmacy Pacific Fair, with the green prescriptions and advice sign at the back of the store', caption: 'Inside the store, with prescriptions and advice at the back' },
  { src: scriptsCounter, alt: 'The green "scripts in" prescription counter at Priceline Pharmacy Pacific Fair, with a pharmacist behind it', caption: 'The prescription counter, at the back of the store' },
  { src: dispensaryCounter, alt: 'Pharmacist Jason Markey at the dispensary counter, in front of shelves of pharmacy medicines', caption: 'Pharmacist Jason Markey at the dispensary' },
  { src: beautyAisle, alt: 'The brightly lit makeup and beauty aisle at Priceline Pharmacy Pacific Fair', caption: 'The beauty aisle' },
  { src: fragranceCabinets, alt: 'Glass fragrance cabinets lit in pink under a fragrance sign', caption: 'Fragrance cabinets' },
  { src: helpMedicalEntrance, alt: 'The entrance to Help Medical, with its green sign, inside Priceline Pharmacy Pacific Fair', caption: 'Help Medical, an independent general practice located inside our store' },
];

const path = '/visit-us/';
// Christmas and New Year trading days still ahead (the card and FAQ disappear once they've passed)
const xmas = upcomingSpecialHours();
const xmasFaq = xmas.length
  ? [{ q: 'What are your Christmas and New Year hours?', a: 'We trade Pacific Fair’s extended Christmas hours: open late from Friday 18 December, and until midnight on Wednesday 23 December. We’re closed on Christmas Day, open 8am to 6pm on Boxing Day, and open 10am to 5pm on New Year’s Day. The full list is on this page.' }]
  : [];
const breadcrumbs = [{ name: 'Home', href: '/' }, { name: 'Visit us', href: path }];
const mapsEmbed = `https://www.google.com/maps?q=${encodeURIComponent('Priceline Pharmacy Pacific Fair, Shop 81 Pacific Fair Shopping Centre, Hooker Blvd, Broadbeach QLD 4218')}&output=embed`;
const faqs = [
  { q: 'Are you open on Sundays?', a: 'Yes, we’re open 7 days a week, including Sundays. Our full hours are listed on this page; check our Google listing for public holiday hours before you visit.' },
  ...xmasFaq,
  { q: 'When is the store quietest?', a: `${site.quietTime.sentence} It’s a good time to walk in for a vaccination, ear piercing or passport photos.` },
  { q: 'Which entrance is closest to the pharmacy?', a: 'We’re on the ground floor on the north-eastern side of Pacific Fair, near the outdoor entrance from the river and next to Proud Smile. Park in the Orange car park, directly under us (Gate 7 is closest), or on the undercover rooftop above us, and you’re a short walk away.' },
  { q: 'Is parking free?', a: 'Yes, for the first 4 hours each day, and all day if you spend over $300 in the centre. Entry and exit are ticketless: a camera reads your number plate. See <a href="' + site.links.pacificFairParking + '" rel="noopener">Pacific Fair’s parking page</a> for rates beyond 4 hours and accessible parking.' },
  { q: 'Is the store wheelchair accessible?', a: 'Yes. The store has a level, step-free entrance from the centre and accessible parking nearby. Pacific Fair has accessible toilets and parents’ rooms. Call us if you’d like help planning your visit.' },
  { q: 'Where do I park for Priceline?', a: 'In the Orange car park, directly under us. Pacific Fair signposts Gates 7 and 8 as the best parking for Priceline, and the first 4 hours are free.' },
  { q: 'What if you’re closed?', a: 'For health advice after hours, call 13 HEALTH (13 43 25 84), any time of the day or night. In an emergency, call 000.' + (live.has('after-hours-medical-help-broadbeach') ? ' Our guide to <a href="/after-hours-medical-help-broadbeach/">getting medical help after hours near Broadbeach</a> lists the other options.' : '') },
  { q: 'How do I get there by public transport?', a: 'Take the G:link light rail to Broadbeach South station, right out the front of Pacific Fair, or a bus to the Pacific Fair interchange on Hooker Boulevard. Plan your trip with Translink, then walk in to the ground floor.' },
];
---

<ContentPage
  title="Opening Hours & Parking | Priceline Pacific Fair, Broadbeach"
  description="Shop 81, ground floor of Pacific Fair (Pac Fair), Broadbeach. Open 7 days, Thursdays until 9pm. Park free for 4 hours in the Orange car park, Gate 7."
  path={path}
  h1="Opening hours and how to find us"
  lead="Shop 81, ground floor of Pacific Fair in Broadbeach, next to Proud Smile. Open 7 days, until 9pm on Thursdays, with 4 hours’ free parking right under us."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  showNap
  ogImage={shopfront}
  dateModified="2026-10-17"
>
  <div class="btn-row">
    <a class="btn btn--primary" href={site.phoneHref} data-event="call">Call {site.phone}</a>
    <a class="btn btn--secondary" href={site.links.googleBusinessProfile} rel="noopener" data-event="directions">Open in Google Maps</a>
  </div>

  <h2>Opening hours</h2>
  <div class="hours-grid">
    <HoursCard heading="Priceline Pharmacy Pacific Fair" hours={site.hours} note={xmas.length ? 'Christmas and New Year hours are below. Other public holiday hours are updated on our Google listing.' : 'Public holiday hours (for example Christmas and Easter) are always updated on our Google listing. Search “Priceline Pharmacy Pacific Fair” to check before you visit.'} />    <HoursCard heading="Help Medical (GPs inside our store)" hours={site.helpMedical.hours} note={`Independent general practice. Bookings at helpmedical.au or ${site.helpMedical.phone}.`} />
  </div>
  {xmas.length > 0 && (
    <div class="hours-grid hours-grid--full">
      <HoursCard id="christmas-hours" heading="Christmas and New Year hours" rows={specialRows(xmas)} note="Pacific Fair’s extended trading hours. Help Medical sets its own holiday hours." />
    </div>
  )}
  <p>We’re open on every Queensland public holiday except Christmas Day, Good Friday and Anzac Day. See <a href="/public-holiday-hours/">public holiday hours</a> for the dates.</p>
  <p>{site.quietTime.sentence}</p>
  <p>QML Pathology collection, inside Help Medical: {site.pathology.hoursText} <a href="/blood-tests/">More about blood tests</a>.</p>

  <h2>Where is the pharmacy inside Pacific Fair?</h2>
  <p><strong>{site.name}</strong><br />{site.address.oneLine}<br />Phone <a href={site.phoneHref}>{site.phone}</a> · Email <a href={`mailto:${site.emailGeneral}`}>{site.emailGeneral}</a></p>
  <p>We’re on the north-eastern side of the centre. Park in the Orange car park directly under us (Gate 7 is closest, and the first 4 hours are free), or take the light rail to Broadbeach South, right out the front.</p>
  <Image src={shopfront} alt="The red Priceline Pharmacy shopfront on the ground floor of Pacific Fair, below the centre signs to JB Hi-Fi, Myer and Kmart" widths={[480, 760]} sizes="(max-width: 760px) 100vw, 760px" />
  <p>You’ll find us on the ground floor, next to Proud Smile on our right, with the outdoor entrance from the river on our left. Look for the red Priceline Pharmacy shopfront below the centre signs to JB Hi-Fi, Myer and Kmart. Once you’re inside, the prescription counter is on the left at the very back of the store, and <a href="/help-medical/">Help Medical</a> is on the right-hand side as you walk in.</p>
  <div class="map">
    <iframe title="Map showing Priceline Pharmacy Pacific Fair in Broadbeach" src={mapsEmbed} width="760" height="360" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  </div>

  <h2>Where should I park?</h2>
  <p>Pacific Fair offers <strong>4 hours of free parking</strong> each day, and complimentary all-day parking when you spend over $300 in the centre. Entry and exit are ticketless: a camera reads your number plate, so remember your plate if you’re staying longer than 4 hours. Free all-day parking is available with an accessible parking permit.</p>
  <ul>
    <li><strong>Orange car park, directly under us:</strong> enter at Gate 7 or Gate 8, which Pacific Fair signposts as the best parking for Priceline. From the Gold Coast Highway, cross the bridge into Pacific Fair and turn right into the car park beneath the north-eastern side of the centre. Gate 7 has high-vehicle bays with 3.2 m clearance.</li>
    <li><strong>Undercover rooftop parking:</strong> head to the north-eastern side of the centre and park on the undercover rooftop level above us.</li>
  </ul>
  <p>For car park maps, rates beyond 4 hours and accessible parking, see <a href={site.links.pacificFairParking} rel="noopener">Pacific Fair’s parking page</a>.</p>

  <h2>How do I get there by light rail or bus?</h2>
  <p>Take the G:link light rail to <strong>Broadbeach South</strong> station, on the Gold Coast Highway right out the front of Pacific Fair. It’s a short walk into the centre, and we’re close to the Gold Coast Highway side. Many bus routes also stop at Broadbeach South and at the Pacific Fair bus interchange on Hooker Boulevard. Plan your trip with <a href={site.links.translink} rel="noopener">Translink</a>.</p>

  <h2>Is the store accessible?</h2>
  <ul>
    <li>Level, step-free entrance from the centre.</li>
    <li>Accessible parking close to the north-eastern entrances, and free all-day parking with a permit.</li>
    <li>Accessible toilets and parents’ rooms in Pacific Fair.</li>
    <li>A private consultation room for vaccinations and pharmacist consultations.</li>
  </ul>

  <h2>Photos of our store</h2>
  <p>Here’s what to look for when you visit. The red Priceline shopfront is on the ground floor of Pacific Fair, and the prescription counter is at the back of the store.</p>
  <div class="gallery">
    {gallery.map((g) => (
      <figure>
        <Image src={g.src} alt={g.alt} widths={[320, 480]} sizes="(max-width: 700px) 50vw, 260px" quality={70} />
        <figcaption>{g.caption}</figcaption>
      </figure>
    ))}
  </div>

  <h2>Questions before you visit?</h2>
  <p>Call us on <a href={site.phoneHref}>{site.phone}</a> or <a href="/contact-us/">send us an email</a>. If we’re closed, call 13 HEALTH (<a href="tel:13432584">13 43 25 84</a>) for health advice any time, or 000 in an emergency.</p>
</ContentPage>

<style>
  .hours-grid { display: grid; gap: var(--s4); margin: var(--s4) 0 var(--s5); }
  @media (min-width: 700px) { .hours-grid { grid-template-columns: 1fr 1fr; } .hours-grid--full { grid-template-columns: 1fr; } }
  .map { margin: var(--s5) 0 var(--s8); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); background: var(--surface); }
  .map iframe { display: block; width: 100%; height: 360px; border: 0; }
  .gallery { display: grid; gap: var(--s4); grid-template-columns: repeat(2, minmax(0, 1fr)); margin: var(--s4) 0 var(--s8); }
  @media (min-width: 700px) { .gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .gallery figure { margin: 0; }
  .gallery img { display: block; width: 100%; height: 180px; object-fit: cover; object-position: center top; border-radius: var(--radius); border: 1px solid var(--border); }
  .gallery figcaption { font-size: var(--fs-sm); color: var(--text-muted); margin-top: var(--s2); }
</style>
