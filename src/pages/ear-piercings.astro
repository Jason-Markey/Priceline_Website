---
import ServicePage from '../layouts/ServicePage.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { serviceBySlug } from '../data/services';
import piercingImg from '../assets/images/ear-piercing.jpg';
const service = serviceBySlug('ear-piercings')!;

const faqs = [
  { q: 'How much does ear piercing cost?', a: 'Ear piercing is $65 for both ears. That includes the piercing, your earrings, an antiseptic aftercare spray and a consultation with our team. Earrings are also sold separately, from $12.95. Just walk in.' },
  { q: 'Do I need to book for ear piercing?', a: 'No. Walk-ins are welcome any day we’re open.' },
  { q: 'How old do you have to be?', a: 'We pierce ears for ages 8 and over. Under-16s need a parent or guardian with them to give consent, so bring them along.' },
  { q: 'Does it hurt?', a: 'The piercing itself takes seconds. Most people describe a quick pinch, and the area may feel tender for a few days afterwards. Our team will talk you through it first.' },
  { q: 'How long do I leave the studs in?', a: 'At least 6 weeks for earlobes and around 12 weeks for cartilage piercings. Piercings keep healing on the inside for months after that, so follow the aftercare we give you.' },
  { q: 'Can I swim after getting my ears pierced?', a: 'Avoid pools, the ocean and spas until the piercing has healed, which is worth planning around in a Gold Coast summer. Ask us about timing when you come in.' },
  { q: 'Can you re-pierce an ear that has closed over?', a: 'Yes. Re-piercing is available for piercings that have closed or were placed incorrectly. Ask us and we’ll take a look.' },
  { q: 'Can I get a second hole pierced?', a: 'Yes. We pierce second holes in the earlobe. Walk in any day we’re open.' },
  { q: 'Do you pierce cartilage?', a: `Call us on ${site.phone} before you come in, and we’ll let you know whether we can do the piercing you’re after.` },
  { q: 'Do you do nose piercing?', a: 'No. We pierce ears only.' },
  { q: 'Do you sell sleepers?', a: 'Yes. We sell sleepers and other earrings for when your piercing has healed. Leave your starter studs in for at least 6 weeks for earlobes before you change them.' },
  { q: 'When is the best time to come in?', a: `${site.quietTime.sentence} You can walk in any time we’re open.` },
];
---

<ServicePage
  service={service}
  title="Priceline Ear Piercing Pacific Fair | $65 Both Ears, Walk In"
  description="Walk in for ear piercing at Priceline Pacific Fair, Broadbeach. $65 for both ears, including earrings, antiseptic spray and a consultation. Ages 8+."
  h1="Ear piercing at Pacific Fair"
  lead="Ear piercing at Priceline Pharmacy Pacific Fair in Broadbeach is $65 for both ears, walk-in, and takes about 15 minutes. The price includes your earrings, an antiseptic aftercare spray and a consultation, using a hygienic single-use system, and you can come in any day we’re open. We pierce ages 8 and over; under-16s need a parent or guardian with them."
  faqs={faqs}
  hub={{ name: 'Beauty & everyday', href: '/beauty-fragrance/' }}
  primaryCta={{ label: 'Get directions', href: site.directionsUrl, external: true, event: 'cta_directions' }}
  secondaryCta={{ label: `Call ${site.phone}`, href: site.phoneHref, event: 'cta_call' }}
  dateModified="2026-10-13"
>
  <h2>How much does ear piercing cost?</h2>
  <Image src={piercingImg} alt="Ear piercing at Priceline Pharmacy Pacific Fair" widths={[480, 760]} sizes="(max-width: 760px) 100vw, 760px" />
  <p>Ear piercing is <strong>$65 for both ears</strong>, including the piercing, your earrings, an antiseptic aftercare spray and a consultation with our team. Earrings are also sold separately, from $12.95.</p>

  <h2>Who can get their ears pierced?</h2>
  <ul>
    <li><strong>Ages 8 and over.</strong> Under-16s need a parent or guardian with them to give consent.</li>
    <li><strong>Second holes</strong> in the earlobe are fine too.</li>
    <li><strong>Re-piercing</strong> is available for piercings that have closed or were placed incorrectly.</li>
    <li><strong>Cartilage:</strong> call us first to check we can do the piercing you’re after.</li>
    <li><strong>Ears only.</strong> We don’t do nose piercing.</li>
  </ul>

  <h2>Do I need to book for ear piercing?</h2>
  <p>No. Walk in any day we’re open and our trained team will fit you in. {site.quietTime.sentence}</p>

  <h2>Which studs and earrings can I choose?</h2>
  <ul>
    <li>Studs suitable for sensitive ears, made from lead-free materials</li>
    <li>Gold-plated and sterling silver earrings</li>
    <li>Clear retainer studs for work or school</li>
    <li>Sleepers and other earrings to change into once your piercing has healed</li>
  </ul>

  <h2>What happens during the piercing?</h2>
  <ol>
    <li>We talk you through the process and confirm consent (a parent or guardian gives consent for under-16s).</li>
    <li>You choose your studs.</li>
    <li>We clean the area and mark the position, and you check it in the mirror.</li>
    <li>The piercing itself takes seconds.</li>
    <li>We go through aftercare with you before you leave.</li>
  </ol>

  <h2>How do I look after a new piercing?</h2>
  <ul>
    <li>Leave your starter studs in for at least 6 weeks for earlobes, and around 12 weeks for cartilage piercings. Piercings keep healing on the inside for months after that.</li>
    <li>Clean the piercing twice a day with the aftercare spray or salt water, without taking the studs out. Wash your hands first.</li>
    <li>Don’t use alcohol or tea tree oil on a new piercing.</li>
    <li>Avoid swimming in pools, the ocean and spas until it has healed, which is worth planning around in a Gold Coast summer.</li>
    <li>Keep hair products, make-up and perfume away from the area.</li>
  </ul>
  <p>Always read the label and follow the directions for use.</p>

  <h2>When should I get help?</h2>
  <p>See us or your GP if the area becomes increasingly red, hot, swollen or painful, or if there’s pus or a fever. The GPs at <a href="/help-medical/">Help Medical</a>, an independent general practice located inside our store, can see you.</p>
</ServicePage>
