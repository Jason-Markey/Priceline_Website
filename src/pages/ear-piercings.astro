---
import ServicePage from '../layouts/ServicePage.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { serviceBySlug } from '../data/services';
import piercingImg from '../assets/images/ear-piercing.jpg';
const service = serviceBySlug('ear-piercings')!;

const faqs = [
  { q: 'How much does ear piercing cost?', a: 'Ear piercing is $65, which includes the piercing, your earrings, antiseptic aftercare spray and a consultation with our team. Earrings are also sold separately, from $12.95.' },
  { q: 'Do I need to book for ear piercing?', a: 'No. Walk-ins are welcome any day we’re open. If you’d rather lock in a time, you can book online.' },
  { q: 'How old do you have to be?', a: 'We pierce ears for ages 8 and over. Under-16s need a parent or guardian with them to give consent.' },
  { q: 'Does it hurt?', a: 'The piercing itself takes seconds. Most people describe a quick pinch, and the area may feel tender for a few days afterwards.' },
  { q: 'How long do I leave the studs in?', a: 'At least 6 weeks for earlobes and around 12 weeks for cartilage piercings. Piercings keep healing on the inside for months after that.' },
  { q: 'Can I swim after getting my ears pierced?', a: 'It’s best to avoid pools, the ocean and spas until the piercing has healed, which is worth planning around in a Gold Coast summer.' },
  { q: 'Can you re-pierce an ear that has closed over?', a: 'Yes. Re-piercing is available for piercings that have closed or were placed incorrectly. Ask us and we’ll take a look.' },
];
---

<ServicePage
  service={service}
  title="Ear Piercing at Pacific Fair, Broadbeach | Walk-ins Welcome"
  description="Ear piercing at Priceline Pacific Fair, Broadbeach: $65 including earrings, aftercare spray and a consultation. Walk-ins welcome, ages 8 and over."
  h1="Ear piercing at Pacific Fair"
  lead="Getting your ears pierced should be quick, clean and relaxed. At Priceline Pharmacy Pacific Fair in Broadbeach, our trained team uses a hygienic, single-use system in a pharmacy setting and sends you home with aftercare advice. It’s $65 including earrings, aftercare spray and a consultation. Walk-ins are welcome, or book a time online if you prefer."
  faqs={faqs}
  hub={{ name: 'Beauty & everyday', href: '/beauty-fragrance/' }}
  primaryCta={{ label: 'Book online', href: site.links.book, external: true, event: 'book' }}
  secondaryCta={{ label: `Call ${site.phone}`, href: site.phoneHref, event: 'call' }}
  dateModified="2026-10-07"
>
  <h2>How much does ear piercing cost?</h2>
  <Image src={piercingImg} alt="Ear piercing at Priceline Pharmacy Pacific Fair" widths={[480, 760]} sizes="(max-width: 760px) 100vw, 760px" />
  <p>Ear piercing is <strong>$65</strong>, including the piercing, your earrings, antiseptic aftercare spray and a consultation with our team. Earrings are also sold separately, from $12.95.</p>

  <h2>Who can get their ears pierced?</h2>
  <ul>
    <li><strong>Ages 8 and over.</strong> Under-16s need a parent or guardian with them to give consent.</li>
    <li><strong>Re-piercing</strong> is available for piercings that have closed or were placed incorrectly.</li>
  </ul>

  <h2>Do I need to book?</h2>
  <p>No. Walk in any day we’re open and our trained team will fit you in. Booking is optional: if you’d like to lock in a time, <a href={site.links.book} rel="noopener">book online</a> or call us on <a href={site.phoneHref}>{site.phone}</a>.</p>

  <h2>Which studs and earrings can I choose?</h2>
  <ul>
    <li>Studs suitable for sensitive ears, made from lead-free materials</li>
    <li>Gold-plated and sterling silver earrings</li>
    <li>Clear retainer studs for work or school</li>
  </ul>

  <h2>What happens during the piercing?</h2>
  <ol>
    <li>We talk you through the process and confirm consent (a parent or guardian gives consent for under-16s).</li>
    <li>You choose your studs.</li>
    <li>We clean the area and mark the position, and you check it in the mirror.</li>
    <li>The piercing itself takes seconds.</li>
    <li>We go through aftercare with you before you leave.</li>
  </ol>

  <h2>How do I look after a new piercing?</h2>
  <ul>
    <li>Leave your starter studs in for at least 6 weeks for earlobes, and around 12 weeks for cartilage piercings. Piercings keep healing on the inside for months after that.</li>
    <li>Clean the piercing twice a day with the aftercare spray or salt water, without taking the studs out. Wash your hands first.</li>
    <li>Don’t use alcohol or tea tree oil on a new piercing.</li>
    <li>Avoid swimming in pools, the ocean and spas until it has healed, which is worth planning around in a Gold Coast summer.</li>
    <li>Keep hair products, make-up and perfume away from the area.</li>
  </ul>
  <p>Always read the label and follow the directions for use.</p>

  <h2>When should I get help?</h2>
  <p>See us or your GP if the area becomes increasingly red, hot, swollen or painful, or if there’s pus or a fever. The GPs at <a href="/help-medical/">Help Medical</a> are located inside our store.</p>
</ServicePage>
