---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HoursCard from '../components/HoursCard.astro';
import { site } from '../data/site';
import { serviceBySlug } from '../data/services';
import { faqNode } from '../lib/schema';
import jason from '../assets/images/jason-cutout.png';
import storeInterior from '../assets/images/store-interior.jpg';
import scriptsCounter from '../assets/images/scripts-in-counter.jpg';
import helpMedicalPhoto from '../assets/images/help-medical-reception.jpg';
import icoVacc from '../assets/icons/vaccinations.png';
import icoDoctor from '../assets/icons/doctor.png';
import icoPacking from '../assets/icons/medication-packing.png';
import icoHealth from '../assets/icons/health-station.png';
import icoDiabetes from '../assets/icons/diabetes.png';
import icoReviews from '../assets/icons/medication-reviews.png';
import icoCosmetics from '../assets/icons/cosmetics.png';
import icoApp from '../assets/icons/priceline-app.png';

const title = 'Pharmacy & Chemist Broadbeach | Priceline Pacific Fair';
const description =
  'Your local pharmacy inside Pacific Fair, Broadbeach. Fast scripts, walk-in vaccinations, bulk-billing GPs in store, skincare advice and Uber Eats delivery.';

// Home services grid — same eight tiles and hexagon icons as the current site
const tiles = [
  { slug: 'vaccination-information', label: 'Vaccinations', icon: icoVacc, cta: 'Learn more' },
  { slug: 'help-medical', label: "Doctor's appointment", icon: icoDoctor, cta: 'Book now', href: site.helpMedical.bookingUrl },
  { slug: 'medication-packing', label: 'Medication packing', icon: icoPacking, cta: 'Learn more' },
  { slug: 'health-station', label: 'Health Station', icon: icoHealth, cta: 'Learn more' },
  { slug: 'national-diabetes-services-scheme', label: 'Diabetes & NDSS', icon: icoDiabetes, cta: 'Learn more' },
  { slug: 'medication-reviews', label: 'Medication reviews', icon: icoReviews, cta: 'Learn more' },
  { slug: 'skincare-tanning', label: 'Skincare & cosmetics', icon: icoCosmetics, cta: 'Learn more' },
  { slug: 'download-the-priceline-app', label: 'Priceline app', icon: icoApp, cta: 'Learn more' },
];

const faqs = [
  { q: 'Where is Priceline Pharmacy inside Pacific Fair?', a: 'Ground floor, north-eastern side of the centre, Shop 81, next to Proud Smile and near the outdoor entrance from the river. The prescription counter is at the back of the store on the left. <a href="/visit-us/">Directions and parking</a>.' },
  { q: 'Are you open on Sundays?', a: 'Yes. We’re open 7 days: 8am–5:30pm Monday to Friday (until 9pm on Thursdays), 9am–5:30pm Saturday and 9:30am–4:30pm Sunday.' },
  { q: 'Do I need an appointment for a vaccination?', a: 'No. Walk-ins are welcome every day we’re open. You can also <a href="' + site.links.book + '" rel="noopener">book a time online</a>.' },
  { q: 'Is there a doctor inside the pharmacy?', a: 'Yes. Help Medical, an independent bulk-billing GP clinic, is located inside our store. Walk-ins are welcome, or <a href="/help-medical/">book ahead</a>.' },
  { q: 'Can I send my prescription before I arrive?', a: 'Yes. Send your eScript through the Priceline Pharmacy app or MedAdvisor and choose Priceline Pharmacy Pacific Fair. <a href="/prescriptions/">How it works</a>.' },
];
---

<Base title={title} description={description} path="/" ogImage={storeInterior} schema={[faqNode(faqs)]}>
  <!-- Hero: real text, real photo. Replaces the Slider Revolution carousel. -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1>Your local pharmacy at Pacific Fair, Broadbeach</h1>
        <p class="hero__lead">Fast scripts, walk-in vaccinations, pharmacist consultations and beauty advice you can trust, with bulk-billing GPs right inside the store. Locally owned, open 7 days and until 9pm on Thursdays.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/prescriptions/" data-event="send-script">Send a script</a>
          <a class="btn btn--secondary" href={site.links.book} rel="noopener" data-event="book-vaccination">Book a vaccination</a>
        </div>
        <ul class="hero__quick" aria-label="Quick links">
          <li><a href="/vaccination-information/">Vaccinations</a></li>
          <li><a href="/help-medical/">GP in store</a></li>
          <li><a href="/skincare-tanning/">Beauty advice</a></li>
          <li><a href="/delivery/">Delivery</a></li>
          <li><a href="/visit-us/">Hours &amp; directions</a></li>
        </ul>
      </div>
      <div class="hero__photo">
        <Image src={jason} alt="Jason Markey, owner and pharmacist at Priceline Pharmacy Pacific Fair" widths={[400, 600, 800]} sizes="(max-width: 900px) 70vw, 440px" format="webp" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Why locals choose us (existing copy, kept) -->
  <section class="section">
    <div class="container why">
      <div class="why__intro">
        <h2>Welcome to Priceline Pharmacy Pacific Fair</h2>
        <p>A locally owned community pharmacy on the ground floor of Pacific Fair Shopping Centre in Broadbeach. Whether you’re filling a script, getting a flu shot on your lunch break, or looking for skincare that suits the Gold Coast climate, our pharmacists and beauty advisors take the time to get it right for you.</p>
        <a class="btn btn--outline" href="/about-us/">About us</a>
      </div>
      <div class="why__list">
        <h3>Why locals choose us</h3>
        <ul>
          <li><strong>Pharmacists who make time for you</strong> – ask us anything, no appointment needed.</li>
          <li><strong>Fast, accurate dispensing</strong> with our robotic dispensary. <a href="/prescriptions/">Send your script ahead</a>.</li>
          <li><strong>GPs in store</strong> at <a href="/help-medical/">Help Medical</a>, a bulk-billing clinic for eligible patients.</li>
          <li><strong>Walk-in <a href="/vaccination-information/">vaccinations</a></strong>, with free government-funded vaccines for eligible people and no service fee.</li>
          <li><strong>Beauty advice you can trust</strong> for <a href="/skincare-tanning/">skincare</a>, makeup and <a href="/beauty-fragrance/">fragrance</a>.</li>
          <li><strong>Delivered to your door</strong> anywhere on the Gold Coast through <a href="/delivery/">Uber Eats</a>.</li>
          <li><strong>Open 7 days</strong>, and until 9pm on Thursdays.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Visit us in store (existing section, kept) -->
  <section class="section section--white">
    <div class="container visit">
      <Image src={scriptsCounter} alt="The prescription counter at Priceline Pharmacy Pacific Fair, with a pharmacist ready to take scripts" widths={[480, 760, 1024]} sizes="(max-width: 768px) 100vw, 520px" class="visit__img" />
      <div class="visit__copy">
        <h2>Visit us in store today</h2>
        <p>{site.address.oneLine}. {site.address.floor.toLowerCase().replace(/^./, (c) => c.toUpperCase())}, {site.address.landmarks.toLowerCase()}.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/visit-us/">Hours &amp; directions</a>
          <a class="btn btn--outline" href={site.directionsUrl} rel="noopener" data-event="directions">Open in Google Maps</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Store hours (existing two cards) -->
  <section class="section">
    <div class="container">
      <h2 class="centre">Store hours</h2>
      <p class="centre intro">Opening hours at Priceline Pharmacy Pacific Fair, and at Help Medical, the GP clinic inside our store.</p>
      <div class="hours-grid">
        <HoursCard heading="Priceline Pharmacy Pacific Fair" hours={site.hours} note={site.hoursNote} />
        <HoursCard heading="Help Medical hours" hours={site.helpMedical.hours} note="Independent GP clinic inside our store. Bookings at helpmedical.au." />
      </div>
    </div>
  </section>

  <!-- Our services grid (existing eight tiles + hexagon icons) -->
  <section class="section section--white">
    <div class="container">
      <h2 class="centre">Our services</h2>
      <p class="centre intro">Most services need no appointment, so just walk in. For the full list, see <a href="/pharmacy-services/">pharmacy services</a>.</p>
      <ul class="tiles">
        {tiles.map((t) => {
          const s = serviceBySlug(t.slug)!;
          const href = t.href ?? `/${t.slug}/`;
          return (
            <li class="tile">
              <a class="tile__link" href={href} rel={t.href ? 'noopener' : undefined}>
                <Image src={t.icon} alt="" width={100} height={109} class="tile__icon" />
                <span class="tile__label">{t.label}</span>
                <span class="tile__desc">{s.short}</span>
              </a>
              <a class="btn btn--primary btn--sm" href={href} rel={t.href ? 'noopener' : undefined} aria-label={`${t.cta}: ${t.label}`}>{t.cta}</a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- Help Medical strip -->
  <section class="section">
    <div class="container hm">
      <div class="hm__copy">
        <h2>See a GP without leaving the store</h2>
        <p>Help Medical, {site.helpMedical.relationship}, offers bulk billing for eligible patients and welcomes walk-ins. See a doctor, then have your script filled a few steps away. A QML Pathology collection room operates inside Help Medical on weekday mornings.</p>
        <div class="btn-row">
          <a class="btn btn--secondary" href={site.helpMedical.bookingUrl} rel="noopener" data-event="book-gp">Book a GP</a>
          <a class="btn btn--outline" href="/help-medical/">About Help Medical</a>
        </div>
      </div>
      <Image src={helpMedicalPhoto} alt="Help Medical reception and waiting area inside Priceline Pharmacy Pacific Fair" widths={[480, 760, 1024]} sizes="(max-width: 768px) 100vw, 520px" class="hm__img" />
    </div>
  </section>

  <!-- Beauty strip -->
  <section class="section section--pale">
    <div class="container beauty">
      <Image src={storeInterior} alt="Inside Priceline Pharmacy Pacific Fair: the checkout, beauty aisles and prescription counter" widths={[480, 760, 1024]} sizes="(max-width: 768px) 100vw, 520px" class="beauty__img" />
      <div class="beauty__copy">
        <h2>Skincare, makeup and fragrance, with real advice</h2>
        <p>Our trained beauty advisors help you find products that suit your skin and the Gold Coast climate: strong sun, humidity, salt water and air-conditioning. No booking, no charge. Shop in store, or order for Click &amp; Collect and Uber Eats delivery.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/skincare-tanning/">Skincare &amp; self-tan</a>
          <a class="btn btn--outline" href="/beauty-fragrance/">Makeup &amp; fragrance</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section">
    <div class="container measure">
      <div class="faq">
        <h2>Quick answers</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq-body"><p set:html={f.a} /></div>
          </details>
        ))}
      </div>
      <p>More in our <a href="/frequently-asked-questions/">frequently asked questions</a>.</p>
    </div>
  </section>

  <!-- Contact card (existing "Have any questions?") -->
  <section class="section section--white">
    <div class="container">
      <div class="contact card">
        <div>
          <h2>Have a question?</h2>
          <p>Call us on <a href={site.phoneHref}>{site.phone}</a>, or email <a href={`mailto:${site.emailGeneral}`}>{site.emailGeneral}</a>. For prescription and medicine questions, <a href={`mailto:${site.emailPharmacy}`}>{site.emailPharmacy}</a>.</p>
        </div>
        <a class="btn btn--primary" href="/contact-us/">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .centre { text-align: center; }
  .intro { max-width: 640px; margin-inline: auto; margin-bottom: var(--s8); }
  h2.centre { margin-top: 0; }

  /* Hero */
  .hero { background: var(--pink-pale); overflow: hidden; }
  .hero__inner { display: grid; gap: var(--s4); padding-top: var(--s8); }
  .hero__copy { padding-bottom: var(--s2); }
  .hero h1 { font-size: clamp(2rem, 1.3rem + 2.8vw, var(--fs-hero)); margin-bottom: var(--s4); max-width: 18ch; }
  .hero__lead { font-size: var(--fs-lg); color: var(--charcoal); max-width: 52ch; }
  .hero .btn-row { margin-bottom: var(--s5); }
  .hero__quick { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2) var(--s5); font-size: var(--fs-sm); font-weight: 600; }
  .hero__quick a { color: var(--pink-deep); }
  /* Cut-out portrait sits on the pink and bleeds off the bottom edge, like the store's banner artwork */
  .hero__photo { justify-self: center; width: min(70vw, 300px); margin-top: var(--s4); margin-bottom: -4px; }
  .hero__photo img { width: 100%; height: auto; display: block; }
  @media (min-width: 900px) {
    .hero__inner { grid-template-columns: 1fr 440px; gap: var(--s12); padding-top: var(--s10); align-items: end; }
    .hero__copy { padding-block: var(--s12) var(--s16); align-self: center; }
    .hero__photo { width: 440px; margin: 0; justify-self: end; }
    .hero__photo img { max-height: 560px; width: auto; margin-left: auto; }
  }

  /* Why */
  .why { display: grid; gap: var(--s10); }
  @media (min-width: 900px) { .why { grid-template-columns: 1fr 1fr; gap: var(--s16); } }
  .why h2, .why h3 { margin-top: 0; }
  .why__list ul { padding-left: 1.2em; }

  /* Visit / HM / Beauty two-column strips */
  .visit, .hm, .beauty { display: grid; gap: var(--s8); align-items: center; }
  @media (min-width: 900px) { .visit, .hm, .beauty { grid-template-columns: 1fr 1fr; gap: var(--s16); } }
  .visit h2, .hm h2, .beauty h2 { margin-top: 0; }
  .visit__img, .hm__img, .beauty__img { border-radius: var(--radius-lg); width: 100%; height: auto; }
  @media (min-width: 900px) { .hm__img { order: 2; } }

  /* Hours */
  .hours-grid { display: grid; gap: var(--s5); max-width: 820px; margin-inline: auto; }
  @media (min-width: 700px) { .hours-grid { grid-template-columns: 1fr 1fr; } }

  /* Service tiles */
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s5); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 900px) { .tiles { grid-template-columns: repeat(4, 1fr); gap: var(--s6); } }
  .tile { display: flex; flex-direction: column; align-items: center; gap: var(--s3); }
  .tile__link { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--s3); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--s6) var(--s4); width: 100%; height: 100%; text-decoration: none; color: var(--text); box-shadow: var(--shadow); transition: border-color .15s; }
  .tile__link:hover { border-color: var(--pink); color: var(--text); }
  .tile__icon { width: 88px; height: 96px; object-fit: contain; }
  .tile__label { color: var(--charcoal); font-weight: 700; font-size: 1.0625rem; }
  .tile__desc { font-size: 0.875rem; }


  /* Contact card */
  .contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s5); border-left: 4px solid var(--pink); }
  .contact h2 { margin: 0 0 var(--s2); font-size: 1.375rem; }
  .contact p { margin: 0; }
</style>
