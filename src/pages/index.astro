---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HoursCard from '../components/HoursCard.astro';
import Reviews from '../components/Reviews.astro';
import { reviewsLive } from '../data/reviews';
import { site, upcomingSpecialHours, fmtDay, brisbaneDate } from '../data/site';
import { serviceBySlug } from '../data/services';
import { faqNode } from '../lib/schema';
import jason from '../assets/images/jason-cutout.png';
import storeInterior from '../assets/images/store-interior.jpg';
import beautyAisle from '../assets/images/beauty-aisle.jpg';
import fragranceCabinets from '../assets/images/fragrance-cabinets.jpg';
import shopfront from '../assets/images/shopfront.jpg';
import helpMedicalPhoto from '../assets/images/help-medical-reception.jpg';
import icoVacc from '../assets/icons/vaccinations.png';
import icoDoctor from '../assets/icons/doctor.png';
import icoPacking from '../assets/icons/medication-packing.png';
import icoEar from '../assets/icons/ear-piercing.png';
import icoPassport from '../assets/icons/passport-photos.png';
import icoUti from '../assets/icons/uti-treatment.png';
import icoConsult from '../assets/icons/contraception-consult.png';
import icoCollect from '../assets/icons/click-and-collect.png';

// Christmas and New Year trading still ahead: a one-line pointer under the hours cards
const xmas = upcomingSpecialHours();
const lateNight = xmas.find((s) => s.hours?.close === '24:00');
// Until Christmas Eve the note also points to the gift guide; the first rebuild after Christmas drops the link
const giftGuide = brisbaneDate() <= '2026-12-24';

const title = 'Priceline Pharmacy Pacific Fair | Broadbeach Chemist, 7 Days';
const description =
  'Your local chemist at Pac Fair, Broadbeach, open 7 days. Scripts ready in minutes, walk-in vaccinations, GPs in store, ear piercing and passport photos.';

// Home services grid: the eight services people search for most (Search Console, Oct 2026), in the same
// tile and hexagon-icon style as the original site. Every tile links internally; the rest are on /pharmacy-services/.
const tiles = [
  { slug: 'ear-piercings', label: 'Ear piercing', icon: icoEar, cta: 'About ear piercing' },
  { slug: 'vaccination-information', label: 'Walk-in vaccinations', icon: icoVacc, cta: 'About vaccinations' },
  { slug: 'help-medical', label: "Doctor's appointment", icon: icoDoctor, cta: 'About Help Medical' },
  { slug: 'passport-photos', label: 'Passport photos', icon: icoPassport, cta: 'About passport photos' },
  { slug: 'uti-treatment', label: 'UTI treatment', icon: icoUti, cta: 'About UTI treatment' },
  { slug: 'contraception-consultations', label: 'Contraception consults', icon: icoConsult, cta: 'About contraception' },
  { slug: 'click-and-collect', label: 'Click & Collect', icon: icoCollect, cta: 'About Click & Collect' },
  { slug: 'medication-packing', label: 'Medication packing', icon: icoPacking, cta: 'About medication packing' },
];

const faqs = [
  { q: 'Where is Priceline Pharmacy inside Pacific Fair?', a: 'Shop 81 on the ground floor, north-eastern side of the centre, next to Proud Smile and near the outdoor entrance from the river. Park in the Orange car park, directly under us (Gate 7 is closest). The prescription counter is at the back of the store on the left. <a href="/visit-us/">Get directions and parking tips</a>.' },
  { q: 'Are you open on Sundays?', a: 'Yes. We’re open 7 days a week, and until 9pm on Thursdays, and on most public holidays (see <a href="/public-holiday-hours/">public holiday hours</a>). <a href="/visit-us/">See our full opening hours</a>.' },
  { q: 'Do I need an appointment for a vaccination?', a: 'No. Walk in any day we’re open, including for <a href="/flu-vaccination/">flu shots</a>, and scan the QR code at the counter to join the queue, or <a href="' + site.links.book + '" rel="noopener">book a time online</a> if you’d rather not wait. ' + site.quietTime.sentence },
  { q: 'Is there a doctor inside the pharmacy?', a: 'Yes. Help Medical is an independent general practice located inside our store, and it bulk bills everyone with a Medicare card. Walk in subject to doctor availability, or <a href="/help-medical/">book a GP ahead</a>.' },
  { q: 'Can I send my prescription before I arrive?', a: `Yes. Email your eScript to ${site.emailPharmacy}, or send it through the Priceline Pharmacy app or MedAdvisor, and we’ll have it ready to collect. <a href="/prescriptions/">Send a script ahead</a>.` },
];
---

<Base title={title} description={description} path="/" ogImage={storeInterior} schema={[faqNode(faqs.map((f) => ({ q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))]}>
  <!-- Hero: real text, real photo. Replaces the Slider Revolution carousel. -->
  <section class="hero" data-cta-location="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1>Priceline Pharmacy Pacific Fair<span class="hero__tag"><span class="sr-only">: </span>Your local chemist in Broadbeach</span></h1>
        <p class="hero__lead">Scripts ready in minutes, walk-in vaccinations, GPs in store, and the full Priceline beauty and fragrance range with free advice. Locally owned on the ground floor of Pac Fair, open 7 days and until 9pm on Thursdays.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/prescriptions/" data-event="send-script">Send a script ahead</a>
          <a class="btn btn--secondary" href={site.directionsUrl} rel="noopener" data-event="directions">Get directions</a>
        </div>
      </div>
      <!-- "Today at Shop 81": live status + the four things people come in for, straight under the buttons.
           Charcoal ticket with the true-pink edge. -->
      <section class="hero__today" aria-labelledby="today-h" data-cta-location="today">
        <div class="today">
          <div class="today__status">
            <h2 id="today-h" class="today__h">Today at Shop 81</h2>
            <p class="today__open" id="today-span">Open 7 days</p>
            <p class="today__sub"><a href="/visit-us/">All hours &amp; directions</a></p>
          </div>
          <dl class="today__rows">
            <div><dt>Scripts</dt><dd>Ready in minutes. <a href="/prescriptions/">Send yours ahead</a></dd></div>
            <div><dt>Vaccinations</dt><dd><a href="/vaccination-information/">Walk in</a>, no appointment</dd></div>
            <div><dt>GP</dt><dd>Help Medical in store. <a href="/help-medical/">Book a doctor</a></dd></div>
            <div><dt>Late night</dt><dd>Thursdays until 9pm</dd></div>
          </dl>
        </div>
      </section>
      <div class="hero__photo">
        <Image src={jason} alt="Jason Markey, owner and pharmacist at Priceline Pharmacy Pacific Fair" widths={[400, 600, 800]} sizes="(max-width: 900px) 70vw, 440px" format="webp" loading="eager" fetchpriority="high" />
        <p class="hero__caption">Jason Markey, owner and pharmacist</p>
      </div>
    </div>
  </section>

  <!-- Band A: who we are + where we are -->
  <section class="section section--white">
    <div class="container band-a" data-cta-location="home_body">
      <div class="band-a__text">
        <h2>A locally owned chemist inside Pacific Fair</h2>
        <p>Priceline Pharmacy Pacific Fair is an independently owned Priceline Pharmacy franchise store on the ground floor of Pacific Fair Shopping Centre (Pac Fair) in Broadbeach. Whether you’re filling a script, getting a flu shot on your lunch break or after skincare that copes with the Gold Coast climate, our pharmacists and beauty advisors take the time to get it right.</p>
        <h3>Why locals choose us</h3>
        <ul>
          <li><strong>Here since 2009, pharmacist-owned.</strong> Ask our pharmacists anything, no appointment needed.</li>
          <li><strong>Scripts ready in minutes</strong>, thanks to our robotic dispensary. <a href="/prescriptions/">Send yours ahead</a>.</li>
          <li><strong>Walk-in <a href="/vaccination-information/">vaccinations</a>, including <a href="/flu-vaccination/">flu shots</a></strong>, free for eligible people under the National Immunisation Program, with no service fee.</li>
          <li><strong>GPs in store</strong> at <a href="/help-medical/">Help Medical</a>, an independent general practice located inside our store, bulk billing everyone with a Medicare card.</li>
        </ul>
        <a class="btn btn--outline" href="/about-us/">Meet the team</a>
      </div>
      <div class="band-a__find">
        <Image src={shopfront} alt="The red Priceline Pharmacy shopfront on the ground floor of Pacific Fair, below the centre signs to JB Hi-Fi, Myer and Kmart" widths={[480, 760, 1024]} sizes="(max-width: 768px) 100vw, 520px" class="band-a__img" />
        <h3>Find us on the ground floor</h3>
        <p>{site.address.oneLine}. {site.address.floor}. {site.address.landmarks}. {site.parking.short} The Broadbeach South light rail stop is right out the front.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/visit-us/">Hours &amp; directions</a>
          <a class="btn btn--secondary" href={site.directionsUrl} rel="noopener" data-event="directions">Open in Google Maps</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Store hours (existing two cards) -->
  <section class="section">
    <div class="container" data-cta-location="home_body">
      <h2>Opening hours</h2>
      <p class="intro">Pharmacy hours, and the hours of Help Medical, an independent general practice located inside our store.</p>
      <div class="hours-grid">
        <HoursCard heading="Priceline Pharmacy Pacific Fair" hours={site.hours} note={site.hoursNote} />
        <HoursCard heading="Help Medical hours" hours={site.helpMedical.hours} note="An independent general practice located inside our store. Bookings at helpmedical.au." />
      </div>
      {xmas.length > 0 && (
        <p class="xmas-note">
          {lateNight ? `Open late for Christmas, until midnight on ${fmtDay(lateNight.date)}. ` : ''}<a href="/visit-us/#christmas-hours">See all Christmas hours</a>
          {giftGuide && <> · <a href="/christmas-gift-ideas/" data-event="gift-ideas">Christmas gift ideas</a></>}
        </p>
      )}
    </div>
  </section>

  <!-- Our services grid (existing eight tiles + hexagon icons) -->
  <section class="section section--white" data-cta-location="tiles">
    <div class="container">
      <h2>What we can help with</h2>
      <p class="intro">Most of our services are walk-in, so there’s no need to book. We also offer <a href="/travel-health/">travel vaccines</a>, <a href="/sick-leave-certificates/">sick leave certificates</a> and <a href="/emergency-contraception/">emergency contraception</a>, and you can have <a href="/blood-tests/">blood tests</a> at the QML Pathology collection room inside Help Medical. See the <a href="/pharmacy-services/">full list of pharmacy services</a>.</p>
      <ul class="tiles">
        {tiles.map((t) => {
          const s = serviceBySlug(t.slug)!;
          return (
            <li class="tile">
              {/* The whole card is the link; the button is a visual affordance inside it (one tab stop, no nested links) */}
              <a class="tile__link" href={`/${t.slug}/`}>
                <Image src={t.icon} alt="" width={100} height={109} densities={[1, 2]} class="tile__icon" />
                <span class="tile__text">
                  <span class="tile__label">{t.label}</span>
                  <span class="tile__desc">{s.short}</span>
                </span>
                <span class="btn btn--primary btn--sm tile__btn">{t.cta}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- Customer reviews: shows once src/data/reviews.ts has enough reviews and a current rating (reviewsLive) -->
  {reviewsLive && (
    <section class="section" data-cta-location="reviews">
      <div class="container">
        <h2>What our customers say</h2>
        <p class="intro">A few of our Google reviews, shown exactly as written.</p>
        <Reviews context="home" />
      </div>
    </section>
  )}

  <!-- Beauty band: full width, the retail heart of the store -->
  <section class="section section--pale">
    <div class="container beauty" data-cta-location="home_body">
      <div class="beauty__copy">
        <h2>Beauty, makeup and fragrance, with advice built for the Gold Coast</h2>
        <p>The full Priceline beauty range is here on the ground floor: makeup from NYX, Maybelline, L’Oréal Paris, Revlon, e.l.f. and Milani, lit fragrance cabinets of designer and celebrity scents, and skincare that copes with strong sun, humidity and salt water. Our beauty advisors help you match a shade, find a scent or choose a gift, with no booking and no charge.</p>
        <ul class="beauty__list">
          <li>Makeup, skincare, hair care and self-tan</li>
          <li><a href="/fragrance/">Designer and celebrity fragrance</a>, with testers in store and gift help</li>
          <li>Free advice from trained beauty advisors</li>
          <li>Shop in store, or order for <a href="/click-and-collect/">Click &amp; Collect</a> and <a href="/delivery/">Uber Eats delivery</a></li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href="/beauty-fragrance/">Makeup &amp; fragrance</a>
          <a class="btn btn--outline" href="/skincare-tanning/">Skincare &amp; self-tan</a>
        </div>
      </div>
      <div class="beauty__photos">
        <Image src={beautyAisle} alt="The beauty aisle at Priceline Pharmacy Pacific Fair, with NYX, Maybelline, L’Oréal and Revlon bays" widths={[480, 760]} quality={68} sizes="(max-width: 900px) 100vw, 560px" class="beauty__img" />
        <Image src={fragranceCabinets} alt="Lit fragrance cabinets at Priceline Pharmacy Pacific Fair" widths={[480, 760]} quality={68} sizes="(max-width: 900px) 100vw, 560px" class="beauty__img" />
      </div>
    </div>
  </section>

  <!-- Help Medical strip -->
  <section class="section">
    <div class="container hm" data-cta-location="home_body">
      <div class="hm__copy">
        <h2>See a GP without leaving the store</h2>
        <p>Help Medical, {site.helpMedical.relationship}, bulk bills everyone with a Medicare card and welcomes walk-ins, subject to doctor availability. See a doctor, then have your script filled a few steps away. <a href="/blood-tests/">QML Pathology</a> collects inside Help Medical on weekday mornings.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={site.helpMedical.bookingUrl} rel="noopener" data-event="book-gp">Book a GP</a>
          <a class="btn btn--outline" href="/help-medical/">About Help Medical</a>
        </div>
      </div>
      <Image src={helpMedicalPhoto} alt="Help Medical reception and waiting area inside Priceline Pharmacy Pacific Fair" widths={[480, 760, 1024]} sizes="(max-width: 768px) 100vw, 520px" class="hm__img" />
    </div>
  </section>

  <!-- Band E: quick answers + ask a pharmacist -->
  <section class="section section--white">
    <div class="container band-e" data-cta-location="home_body">
      <div class="faq">
        <h2>Quick answers</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq-body"><p set:html={f.a} /></div>
          </details>
        ))}
        <p>More in our <a href="/frequently-asked-questions/">frequently asked questions</a>.</p>
      </div>
      <div class="contact card">
        <div>
          <h2>Have a question? Ask a pharmacist</h2>
          <p>Call us on <a href={site.phoneHref}>{site.phone}</a>, or email <a href={`mailto:${site.emailGeneral}`}>{site.emailGeneral}</a>. For prescription and medicine questions, email <a href={`mailto:${site.emailPharmacy}`}>{site.emailPharmacy}</a>.</p>
        </div>
        <a class="btn btn--primary" href="/contact-us/">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { max-width: var(--measure); margin-bottom: var(--s8); }

  /* Hero */
  .hero { background: var(--pink-pale); overflow: hidden; }
  .hero__inner { display: grid; gap: var(--s4); padding-top: var(--s8); }
  .hero__copy { padding-bottom: var(--s2); }
  .hero h1 { font-size: clamp(2rem, 1.3rem + 2.8vw, var(--fs-hero)); margin-bottom: var(--s4); max-width: 18ch; }
  .hero__lead { font-size: var(--fs-lg); color: var(--charcoal); max-width: 52ch; }
  /* Store name leads the H1 (brand searches, 25 Oct 2026); the descriptor sits underneath, smaller. */
  .hero__tag { display: block; font-size: 0.5em; font-weight: 600; line-height: 1.3; margin-top: var(--s2); }
  .hero .btn-row { margin-bottom: var(--s5); }
  /* Quick links are desktop-only (the phone hero keeps just the H1, lead and two CTAs) */
  /* Cut-out portrait sits on the pink and bleeds off the bottom edge, like the store's banner artwork.
     On phones it's capped at 38vh and anchored top so the face shows. */
  .hero__photo { position: relative; justify-self: center; width: min(70vw, 300px); max-height: 38vh; overflow: hidden; margin-top: var(--s4); margin-bottom: -4px; }
  .hero__photo img { width: 100%; height: auto; display: block; object-fit: cover; object-position: top; }
  .hero__caption { position: absolute; left: 0; bottom: var(--s3); margin: 0; font-size: 0.8125rem; line-height: 1.3; color: #5f5f5f; background: rgba(252, 228, 239, .9); padding: 3px 8px 3px 0; border-radius: 0 var(--radius) var(--radius) 0; }
  .hero__today .today { margin-top: 0; }
  @media (min-width: 900px) {
    .hero__inner { grid-template-columns: 1fr 440px; grid-template-areas: "copy photo" "today photo"; column-gap: var(--s12); row-gap: 0; padding-top: var(--s10); align-items: end; }
    .hero__copy { grid-area: copy; padding-block: var(--s10) 0; align-self: end; }
    .hero__today { grid-area: today; padding-bottom: var(--s12); align-self: start; }
    .hero__photo { grid-area: photo; }
    .hero__photo { width: 440px; max-height: none; overflow: visible; margin: 0; justify-self: end; }
    .hero__photo img { max-height: 560px; width: auto; margin-left: auto; }
    /* Desktop: caption sits on the pink to the left of the portrait (never over the photo) */
    .hero__caption { left: auto; right: calc(100% + var(--s4)); bottom: var(--s4); white-space: nowrap; text-align: right; background: none; padding: 0; }
  }

  /* Today at Shop 81 */
    .today { position: relative; background: var(--charcoal); color: #fff; border-radius: var(--radius-lg); padding: var(--s5) var(--s5) var(--s5) calc(var(--s5) + 6px); overflow: hidden; display: grid; gap: var(--s5); margin-top: var(--s5); box-shadow: var(--shadow-md); }
  .today::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--pink); }
  .today__h { color: var(--pink-light); font-size: 0.8125rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 var(--s1); }
  .today__open { margin: 0; font-size: var(--fs-h3); font-weight: 700; line-height: 1.25; }
  .today__sub { margin: var(--s1) 0 0; font-size: var(--fs-sm); }
  .today a { color: var(--pink-light); }
  .today a:hover { color: #fff; }
  .today__rows { margin: 0; display: grid; gap: var(--s2); font-size: var(--fs-sm); }
  .today__rows > div { display: grid; grid-template-columns: 96px 1fr; gap: var(--s3); align-items: baseline; }
  .today dt { color: #c9c9c9; font-weight: 600; }
  .today dd { margin: 0; color: #fff; }
  @media (min-width: 900px) {
    .today { grid-template-columns: 210px 1fr; align-items: center; padding: var(--s5) var(--s6) var(--s5) calc(var(--s6) + 6px); margin-top: var(--s6); }
    .today__status { border-right: 1px solid rgba(255,255,255,.18); padding-right: var(--s6); }
    .today__rows { grid-template-columns: 1fr; gap: var(--s2); }
    .today__rows > div { grid-template-columns: 104px 1fr; }
  }
  /* Small laptops and tablets in landscape: the hero's left column is narrow, so stack status above the rows */
  @media (min-width: 900px) and (max-width: 1199px) {
    .today { grid-template-columns: 1fr; gap: var(--s4); }
    .today__status { border-right: 0; padding-right: 0; border-bottom: 1px solid rgba(255,255,255,.18); padding-bottom: var(--s4); }
  }

  /* Why */
  .why { display: grid; gap: var(--s10); }
  @media (min-width: 900px) { .why { grid-template-columns: 1fr 1fr; gap: var(--s16); } }
  .why h2, .why h3 { margin-top: 0; }
  .why__list ul { padding-left: 1.2em; }

  /* Visit / HM / Beauty two-column strips */
  .visit, .hm, .beauty { display: grid; gap: var(--s8); align-items: center; }
  @media (min-width: 900px) { .visit, .hm, .beauty { grid-template-columns: 1fr 1fr; gap: var(--s16); } }
  .visit h2, .hm h2, .beauty h2 { margin-top: 0; }
  .visit__img, .hm__img { border-radius: var(--radius-lg); width: 100%; height: auto; }
  .beauty__photos { display: grid; gap: var(--s4); order: -1; }
  @media (min-width: 900px) { .beauty__photos { order: 0; } }
  .beauty :global(.beauty__img) { border-radius: var(--radius-lg); width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .beauty__list { padding-left: 1.2em; margin: 0 0 var(--s5); }
  .beauty__list li + li { margin-top: var(--s1); }
  @media (min-width: 900px) { .beauty { grid-template-columns: 1fr 1.1fr; } }
  @media (min-width: 900px) { .hm__img { order: 2; } }

  /* Hours */
  .hours-grid { display: grid; gap: var(--s5); max-width: 820px; margin-inline: auto; }
  .xmas-note { text-align: center; margin: var(--s5) auto 0; max-width: 820px; }
  @media (min-width: 700px) { .hours-grid { grid-template-columns: 1fr 1fr; } }

  /* Service tiles: cards on desktop, compact rows on phones */
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s5); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 900px) { .tiles { grid-template-columns: repeat(4, 1fr); gap: var(--s6); } }
  .tile { display: flex; }
  .tile__link { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--s3); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--s6) var(--s4); width: 100%; text-decoration: none; color: var(--text); box-shadow: var(--shadow); transition: border-color .15s; }
  .tile__link:hover { border-color: var(--pink); color: var(--text); }
  .tile__link:hover .tile__btn { background: var(--pink-dark); border-color: var(--pink-dark); }
  .tile__icon { width: 88px; height: 96px; object-fit: contain; }
  .tile__text { display: flex; flex-direction: column; gap: var(--s2); min-width: 0; }
  .tile__label { color: var(--charcoal); font-weight: 700; font-size: 1.0625rem; }
  .tile__desc { font-size: 0.875rem; }
  .tile__btn { margin-top: auto; width: 100%; }
  @media (max-width: 699px) {
    .tiles { grid-template-columns: 1fr; gap: var(--s3); }
    .tile__link { flex-direction: row; text-align: left; gap: var(--s4); padding: var(--s4); align-items: center; }
    .tile__icon { width: 56px; height: 61px; flex: 0 0 auto; }
    .tile__text { gap: 2px; }
    .tile__btn { display: none; }
  }


  /* Contact card: pale pink CTA surface (the 4px pink border is reserved for information panels) */
  .contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s5); background: var(--pink-pale); border: 0; }
  .contact h2 { margin: 0 0 var(--s2); font-size: 1.375rem; }
  .contact p { margin: 0; }
  .contact a:not(.btn) { color: var(--pink-dark); }
  /* Bands (5-band layout) */
  .band-a { display: grid; gap: var(--s8); }
  .band-a h3 { margin-top: var(--s6); }
  .band-a__text ul { padding-left: 1.2em; }
  .band-a__text li + li { margin-top: var(--s2); }
  .band-a__find { background: var(--bg); border-radius: var(--radius-lg); padding: var(--s5); }
  .band-a__find h3 { margin-top: var(--s4); }
  .band-a :global(.band-a__img) { border-radius: var(--radius); width: 100%; height: auto; }
  @media (min-width: 900px) { .band-a { grid-template-columns: 1.15fr 1fr; gap: var(--s12); align-items: start; } }
  .band-e { display: grid; gap: var(--s8); }
  .band-e .faq { max-width: var(--measure); }
  .band-e .contact { align-self: start; }
