---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HoursCard from '../components/HoursCard.astro';
import { site } from '../data/site';
import { serviceBySlug } from '../data/services';
import { faqNode } from '../lib/schema';
import jason from '../assets/images/jason-cutout.png';
import storeInterior from '../assets/images/store-interior.jpg';
import scriptsCounter from '../assets/images/scripts-in-counter.jpg';
import helpMedicalPhoto from '../assets/images/help-medical-reception.jpg';
import icoVacc from '../assets/icons/vaccinations.png';
import icoDoctor from '../assets/icons/doctor.png';
import icoPacking from '../assets/icons/medication-packing.png';
import icoHealth from '../assets/icons/health-station.png';
import icoDiabetes from '../assets/icons/diabetes.png';
import icoReviews from '../assets/icons/medication-reviews.png';
import icoCosmetics from '../assets/icons/cosmetics.png';
import icoApp from '../assets/icons/priceline-app.png';

const title = 'Priceline Pharmacy Pacific Fair | Broadbeach, Open 7 Days';
const description =
  'Locally owned pharmacy inside Pacific Fair, Broadbeach, open 7 days. Scripts ready in minutes, walk-in vaccinations, GPs in store and Uber Eats delivery.';

// Home services grid — same eight tiles and hexagon icons as the current site. Every tile links internally.
const tiles = [
  { slug: 'vaccination-information', label: 'Walk-in vaccinations', icon: icoVacc, cta: 'About vaccinations' },
  { slug: 'help-medical', label: "Doctor's appointment", icon: icoDoctor, cta: 'About Help Medical' },
  { slug: 'medication-packing', label: 'Medication packing', icon: icoPacking, cta: 'About medication packing' },
  { slug: 'health-station', label: 'Free health checks', icon: icoHealth, cta: 'About health checks' },
  { slug: 'national-diabetes-services-scheme', label: 'Diabetes & NDSS', icon: icoDiabetes, cta: 'About diabetes & NDSS' },
  { slug: 'medication-reviews', label: 'Free medication reviews', icon: icoReviews, cta: 'About medication reviews' },
  { slug: 'skincare-tanning', label: 'Skincare & cosmetics', icon: icoCosmetics, cta: 'About skincare & cosmetics' },
  { slug: 'download-the-priceline-app', label: 'Priceline app', icon: icoApp, cta: 'About the Priceline app' },
];

const faqs = [
  { q: 'Where is Priceline Pharmacy inside Pacific Fair?', a: 'Shop 81 on the ground floor, north-eastern side of the centre, next to Proud Smile and near the outdoor entrance from the river. The prescription counter is at the back of the store on the left. <a href="/visit-us/">Get directions and parking tips</a>.' },
  { q: 'Are you open on Sundays?', a: 'Yes. We’re open 7 days a week, and until 9pm on Thursdays. Public holiday hours are updated on our Google listing. <a href="/visit-us/">See our full opening hours</a>.' },
  { q: 'Do I need an appointment for a vaccination?', a: 'No. Walk in any day we’re open, including for <a href="/flu-vaccination/">flu shots</a>, and scan the QR code at the counter to join the queue, or <a href="' + site.links.book + '" rel="noopener">book a time online</a> if you’d rather not wait.' },
  { q: 'Is there a doctor inside the pharmacy?', a: 'Yes. Help Medical is an independent general practice located inside our store, with bulk billing for eligible patients. Walk in subject to doctor availability, or <a href="/help-medical/">book a GP ahead</a>.' },
  { q: 'Can I send my prescription before I arrive?', a: 'Yes. Send your eScript through the Priceline Pharmacy app or MedAdvisor, choose Priceline Pharmacy Pacific Fair, and we’ll have it ready to collect. <a href="/prescriptions/">Send a script ahead</a>.' },
];
---

<Base title={title} description={description} path="/" ogImage={storeInterior} schema={[faqNode(faqs.map((f) => ({ q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))]}>
  <!-- Hero: real text, real photo. Replaces the Slider Revolution carousel. -->
  <section class="hero" data-cta-location="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1>Your local pharmacy at Pacific Fair, Broadbeach</h1>
        <p class="hero__lead">Scripts ready in minutes, vaccinations with no appointment, and GPs you can see without leaving the store. Locally owned, open 7 days and until 9pm on Thursdays.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/prescriptions/" data-event="send-script">Send a script ahead</a>
          <a class="btn btn--secondary" href={site.links.book} rel="noopener" data-event="book-vaccination">Book a vaccination</a>
        </div>
        <ul class="hero__quick" aria-label="Quick links">
          <li><a href="/vaccination-information/">Walk-in vaccinations</a></li>
          <li><a href="/help-medical/">GPs in store</a></li>
          <li><a href="/skincare-tanning/">Beauty advice</a></li>
          <li><a href="/visiting-the-gold-coast/">Visiting the Gold Coast?</a></li>
          <li><a href="/visit-us/">Hours &amp; directions</a></li>
        </ul>
      </div>
      <div class="hero__photo">
        <Image src={jason} alt="Jason Markey, owner and pharmacist at Priceline Pharmacy Pacific Fair" widths={[400, 600, 800]} sizes="(max-width: 900px) 70vw, 440px" format="webp" loading="eager" fetchpriority="high" />
        <p class="hero__caption">Jason Markey, owner and pharmacist</p>
      </div>
    </div>
  </section>

  <!-- Why locals choose us (existing copy, kept) -->
  <section class="section">
    <div class="container why" data-cta-location="home_body">
      <div class="why__intro">
        <h2>A locally owned pharmacy inside Pacific Fair</h2>
        <p>Priceline Pharmacy Pacific Fair is an independently owned Priceline Pharmacy franchise store on the ground floor of Pacific Fair Shopping Centre in Broadbeach. Whether you’re filling a script, getting a flu shot on your lunch break or after skincare that copes with the Gold Coast climate, our pharmacists and beauty advisors take the time to get it right.</p>
        <a class="btn btn--outline" href="/about-us/">Meet the team</a>
      </div>
      <div class="why__list">
        <h3>Why locals choose us</h3>
        <ul>
          <li><strong>Here since 2009, pharmacist-owned.</strong> Ask our pharmacists anything, no appointment needed.</li>
          <li><strong>Open 7 days</strong>, and until 9pm on Thursdays.</li>
          <li><strong>4 hours free parking at Pacific Fair</strong>, and the Broadbeach South light rail stop is right out the front.</li>
          <li><strong>Scripts ready in minutes</strong>, thanks to our robotic dispensary. <a href="/prescriptions/">Send yours ahead</a>.</li>
          <li><strong>Click &amp; Collect usually ready in 15 minutes</strong>, or <a href="/delivery/">delivered to your door</a> anywhere on the Gold Coast through Uber Eats.</li>
          <li><strong>Walk-in <a href="/vaccination-information/">vaccinations</a>, including <a href="/flu-vaccination/">flu shots</a></strong>, free for eligible people under the National Immunisation Program, with no service fee.</li>
          <li><strong>Every vaccination recorded on the Australian Immunisation Register</strong>, so your record is up to date before you leave.</li>
          <li><strong>GPs in store</strong> at <a href="/help-medical/">Help Medical</a>, an independent general practice located inside our store, with bulk billing for eligible patients.</li>
          <li><strong>Beauty advice from people who know the products</strong>, for <a href="/skincare-tanning/">skincare</a>, makeup and <a href="/beauty-fragrance/">fragrance</a>.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Visit us in store (existing section, kept) -->
  <section class="section section--white">
    <div class="container visit" data-cta-location="home_body">
      <Image src={scriptsCounter} alt="The prescription counter at Priceline Pharmacy Pacific Fair, with a pharmacist ready to take scripts" widths={[480, 760, 1024]} sizes="(max-width: 768px) 100vw, 520px" class="visit__img" />
      <div class="visit__copy">
        <h2>Find us on the ground floor of Pacific Fair</h2>
        <p>{site.address.oneLine}. {site.address.floor}, {site.address.landmarks}. Four hours of free parking each day, and the Broadbeach South light rail stop is right out the front.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/visit-us/">Hours &amp; directions</a>
          <a class="btn btn--secondary" href={site.directionsUrl} rel="noopener" data-event="directions">Open in Google Maps</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Store hours (existing two cards) -->
  <section class="section">
    <div class="container" data-cta-location="home_body">
      <h2>Opening hours</h2>
      <p class="intro">Pharmacy hours, and the hours of Help Medical, an independent general practice located inside our store.</p>
      <div class="hours-grid">
        <HoursCard heading="Priceline Pharmacy Pacific Fair" hours={site.hours} note={site.hoursNote} />
        <HoursCard heading="Help Medical hours" hours={site.helpMedical.hours} note="An independent general practice located inside our store. Bookings at helpmedical.au." />
      </div>
    </div>
  </section>

  <!-- Our services grid (existing eight tiles + hexagon icons) -->
  <section class="section section--white" data-cta-location="tiles">
    <div class="container">
      <h2>What we can help with</h2>
      <p class="intro">Most of our services are walk-in, so there’s no need to book. See the <a href="/pharmacy-services/">full list of pharmacy services</a>.</p>
      <ul class="tiles">
        {tiles.map((t) => {
          const s = serviceBySlug(t.slug)!;
          return (
            <li class="tile">
              {/* The whole card is the link; the button is a visual affordance inside it (one tab stop, no nested links) */}
              <a class="tile__link" href={`/${t.slug}/`}>
                <Image src={t.icon} alt="" width={100} height={109} densities={[1, 2]} class="tile__icon" />
                <span class="tile__text">
                  <span class="tile__label">{t.label}</span>
                  <span class="tile__desc">{s.short}</span>
                </span>
                <span class="btn btn--primary btn--sm tile__btn">{t.cta}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- Help Medical strip -->
  <section class="section">
    <div class="container hm" data-cta-location="home_body">
      <div class="hm__copy">
        <h2>See a GP without leaving the store</h2>
        <p>Help Medical, {site.helpMedical.relationship}, bulk bills eligible patients and welcomes walk-ins, subject to doctor availability. See a doctor, then have your script filled a few steps away. A QML Pathology collection room operates inside Help Medical on weekday mornings.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={site.helpMedical.bookingUrl} rel="noopener" data-event="book-gp">Book a GP</a>
          <a class="btn btn--outline" href="/help-medical/">About Help Medical</a>
        </div>
      </div>
      <Image src={helpMedicalPhoto} alt="Help Medical reception and waiting area inside Priceline Pharmacy Pacific Fair" widths={[480, 760, 1024]} sizes="(max-width: 768px) 100vw, 520px" class="hm__img" />
    </div>
  </section>

  <!-- Beauty strip -->
  <section class="section section--pale">
    <div class="container beauty" data-cta-location="home_body">
      <Image src={storeInterior} alt="Inside Priceline Pharmacy Pacific Fair: the checkout, beauty aisles and prescription counter" widths={[480, 760, 1024]} sizes="(max-width: 768px) 100vw, 520px" class="beauty__img" />
      <div class="beauty__copy">
        <h2>Skincare, makeup and fragrance, with advice built for the Gold Coast</h2>
        <p>Strong sun, humidity, salt water and air-conditioning are hard on skin. Our trained beauty advisors help you find products that suit your skin and our climate, with no booking and no charge. Shop in store, or order for Click &amp; Collect and Uber Eats delivery.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/skincare-tanning/">Skincare &amp; self-tan</a>
          <a class="btn btn--outline" href="/beauty-fragrance/">Makeup &amp; fragrance</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section">
    <div class="container measure" data-cta-location="home_body">
      <div class="faq">
        <h2>Quick answers</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq-body"><p set:html={f.a} /></div>
          </details>
        ))}
      </div>
      <p>More in our <a href="/frequently-asked-questions/">frequently asked questions</a>.</p>
    </div>
  </section>

  <!-- Contact card (existing "Have any questions?") -->
  <section class="section section--white">
    <div class="container" data-cta-location="home_body">
      <div class="contact card">
        <div>
          <h2>Have a question? Ask a pharmacist</h2>
          <p>Call us on <a href={site.phoneHref}>{site.phone}</a>, or email <a href={`mailto:${site.emailGeneral}`}>{site.emailGeneral}</a>. For prescription and medicine questions, email <a href={`mailto:${site.emailPharmacy}`}>{site.emailPharmacy}</a>.</p>
        </div>
        <a class="btn btn--primary" href="/contact-us/">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { max-width: var(--measure); margin-bottom: var(--s8); }

  /* Hero */
  .hero { background: var(--pink-pale); overflow: hidden; }
  .hero__inner { display: grid; gap: var(--s4); padding-top: var(--s8); }
  .hero__copy { padding-bottom: var(--s2); }
  .hero h1 { font-size: clamp(2rem, 1.3rem + 2.8vw, var(--fs-hero)); margin-bottom: var(--s4); max-width: 18ch; }
  .hero__lead { font-size: var(--fs-lg); color: var(--charcoal); max-width: 52ch; }
  .hero .btn-row { margin-bottom: var(--s5); }
  /* Quick links are desktop-only (the phone hero keeps just the H1, lead and two CTAs) */
  .hero__quick { display: none; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; gap: var(--s2) var(--s5); font-size: var(--fs-sm); font-weight: 600; }
  .hero__quick a { color: var(--pink-dark); padding: 6px 0; display: inline-block; }
  /* Cut-out portrait sits on the pink and bleeds off the bottom edge, like the store's banner artwork.
     On phones it's capped at 38vh and anchored top so the face shows. */
  .hero__photo { position: relative; justify-self: center; width: min(70vw, 300px); max-height: 38vh; overflow: hidden; margin-top: var(--s4); margin-bottom: -4px; }
  .hero__photo img { width: 100%; height: auto; display: block; object-fit: cover; object-position: top; }
  .hero__caption { position: absolute; left: 0; bottom: var(--s3); margin: 0; font-size: 0.8125rem; line-height: 1.3; color: var(--text-muted); background: rgba(252, 228, 239, .9); padding: 3px 8px 3px 0; border-radius: 0 var(--radius) var(--radius) 0; }
  @media (min-width: 900px) {
    .hero__inner { grid-template-columns: 1fr 440px; gap: var(--s12); padding-top: var(--s10); align-items: end; }
    .hero__copy { padding-block: var(--s12) var(--s16); align-self: center; }
    .hero__quick { display: flex; }
    .hero__photo { width: 440px; max-height: none; overflow: visible; margin: 0; justify-self: end; }
    .hero__photo img { max-height: 560px; width: auto; margin-left: auto; }
    /* Desktop: caption sits on the pink to the left of the portrait (never over the photo) */
    .hero__caption { left: auto; right: calc(100% + var(--s4)); bottom: var(--s4); white-space: nowrap; text-align: right; background: none; padding: 0; }
  }

  /* Why */
  .why { display: grid; gap: var(--s10); }
  @media (min-width: 900px) { .why { grid-template-columns: 1fr 1fr; gap: var(--s16); } }
  .why h2, .why h3 { margin-top: 0; }
  .why__list ul { padding-left: 1.2em; }

  /* Visit / HM / Beauty two-column strips */
  .visit, .hm, .beauty { display: grid; gap: var(--s8); align-items: center; }
  @media (min-width: 900px) { .visit, .hm, .beauty { grid-template-columns: 1fr 1fr; gap: var(--s16); } }
  .visit h2, .hm h2, .beauty h2 { margin-top: 0; }
  .visit__img, .hm__img, .beauty__img { border-radius: var(--radius-lg); width: 100%; height: auto; }
  @media (min-width: 900px) { .hm__img { order: 2; } }

  /* Hours */
  .hours-grid { display: grid; gap: var(--s5); max-width: 820px; margin-inline: auto; }
  @media (min-width: 700px) { .hours-grid { grid-template-columns: 1fr 1fr; } }

  /* Service tiles: cards on desktop, compact rows on phones */
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s5); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 900px) { .tiles { grid-template-columns: repeat(4, 1fr); gap: var(--s6); } }
  .tile { display: flex; }
  .tile__link { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--s3); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--s6) var(--s4); width: 100%; text-decoration: none; color: var(--text); box-shadow: var(--shadow); transition: border-color .15s; }
  .tile__link:hover { border-color: var(--pink); color: var(--text); }
  .tile__link:hover .tile__btn { background: var(--pink-dark); border-color: var(--pink-dark); }
  .tile__icon { width: 88px; height: 96px; object-fit: contain; }
  .tile__text { display: flex; flex-direction: column; gap: var(--s2); min-width: 0; }
  .tile__label { color: var(--charcoal); font-weight: 700; font-size: 1.0625rem; }
  .tile__desc { font-size: 0.875rem; }
  .tile__btn { margin-top: auto; width: 100%; }
  @media (max-width: 699px) {
    .tiles { grid-template-columns: 1fr; gap: var(--s3); }
    .tile__link { flex-direction: row; text-align: left; gap: var(--s4); padding: var(--s4); align-items: center; }
    .tile__icon { width: 56px; height: 61px; flex: 0 0 auto; }
    .tile__text { gap: 2px; }
    .tile__btn { display: none; }
  }


  /* Contact card: pale pink CTA surface (the 4px pink border is reserved for information panels) */
  .contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s5); background: var(--pink-pale); border: 0; }
  .contact h2 { margin: 0 0 var(--s2); font-size: 1.375rem; }
  .contact p { margin: 0; }
</style>
