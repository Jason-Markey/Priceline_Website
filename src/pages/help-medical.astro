---
import ServicePage from '../layouts/ServicePage.astro';
import { Image, getImage } from 'astro:assets';
import { site, hoursRows } from '../data/site';
import { serviceBySlug } from '../data/services';
import { helpMedicalDoctors } from '../data/team';
import { helpMedicalNode, ID } from '../lib/schema';
import receptionImg from '../assets/images/help-medical-reception.jpg';
import entranceImg from '../assets/images/help-medical-entrance.jpg';
const service = serviceBySlug('help-medical')!;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*', { eager: true });
const doctors = helpMedicalDoctors.map((d) => ({
  ...d,
  img: d.photo ? images[`../assets/images/${d.photo}`]?.default : undefined,
}));

// Each GP as a Person working at the clinic (names, photos and bios as listed by Help Medical, with their permission)
const doctorNodes = await Promise.all(doctors.map(async (d) => ({
  '@type': 'Person',
  name: d.name,
  jobTitle: d.role,
  ...(d.credentials ? { honorificSuffix: d.credentials } : {}),
  ...(d.languages ? { knowsLanguage: d.languages } : {}),
  description: d.bio,
  ...(d.img ? { image: `${site.url}${(await getImage({ src: d.img, width: 400, format: 'jpg' })).src}` } : {}),
  worksFor: { '@id': ID.helpMedical },
})));

const hm = site.helpMedical;
const listJoin = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}` : xs[0]);
const hmHours = hoursRows(hm.hours);

const faqs = [
  { q: 'Is there a doctor at Pacific Fair?', a: `Yes. Help Medical, an independent general practice, is inside Priceline Pharmacy Pacific Fair at Shop 81 on the ground floor, ${site.helpMedical.whereInStore.toLowerCase()}. The GPs see patients 7 days, bulk bill everyone with a Medicare card and have a QML Pathology collection room on site.` },
  { q: 'Is Help Medical part of Priceline Pharmacy?', a: 'No. Help Medical is an independent general practice located inside our store. The pharmacy and the clinic are run separately, but being under one roof means you can see a GP and fill your script in one visit.' },
  { q: 'Does Help Medical bulk bill?', a: 'Yes. Help Medical bulk bills everyone with a Medicare card. Patients without Medicare, such as overseas visitors, are private patients and pay a fee, so ask about the cost when you book.' },
  { q: 'Which languages do the doctors speak?', a: 'Dr David Seton and Dr Robert Seton speak English and Afrikaans. Dr Md Tariqul Islam speaks Bengali, English, Hindi and Urdu.' },
  { q: 'Is Dr David Seton taking new patients?', a: `Not at the moment. Existing patients, meaning those seen in the past 24 months, can still book with him. New patients can book with Dr Robert Seton or Dr Md Tariqul Islam. <a href="${site.helpMedical.bookingUrl}" rel="noopener">HotDoc</a> shows each doctor’s current availability.` },
  { q: 'Can I walk in without an appointment?', a: 'Yes. Help Medical welcomes walk-ins, subject to doctor availability. On busy days appointments fill quickly, so booking ahead online is the surest way to be seen.' },
  { q: 'How do I book a GP appointment?', a: `Book online through HotDoc (the link on helpmedical.au) or call Help Medical on ${hm.phone}. Please contact the clinic directly rather than the pharmacy for appointments.` },
  { q: 'Can I get a blood test there?', a: `Yes. A QML Pathology collection room operates inside Help Medical, open ${site.pathology.hoursText.replace(/\.$/, '')}. Bring your pathology request form. See <a href="/blood-tests/">blood tests at Pacific Fair</a>.` },
  { q: 'Can I fill my prescription straight after seeing the doctor?', a: 'Yes. After your appointment, bring your script to our dispensary a few steps away and our pharmacists will fill it while you wait, usually within minutes.' },
  { q: 'Can visitors to the Gold Coast see a doctor here?', a: 'Yes. Help Medical welcomes visitors and new patients, and walk-ins are seen subject to doctor availability. Medicare applies for eligible card holders; otherwise a private fee applies. See our <a href="/visiting-the-gold-coast/">guide for visitors to the Gold Coast</a>.' },
  { q: 'Can my child under 5 be vaccinated here?', a: 'Our pharmacists vaccinate people aged 5 and over, so children under 5 can see the GPs at Help Medical for their vaccinations. See <a href="/vaccination-information/">vaccinations</a> and <a href="/flu-vaccination/">flu vaccination</a> for what the pharmacy offers.' },
];
---

<ServicePage
  service={service}
  title="Help Medical Pacific Fair | Bulk-Billing GP inside Priceline"
  description="Help Medical, the GP clinic inside Priceline Pacific Fair: Dr David Seton, Dr Robert Seton and Dr Tariqul Islam. Open 7 days, walk-ins welcome, bulk billed."
  h1="Help Medical: GPs inside Priceline Pacific Fair"
  lead="Help Medical, an independent general practice located inside our store, means you can see a GP and fill the script in one visit at Pacific Fair in Broadbeach. The clinic is open 7 days, bulk bills everyone with a Medicare card, and has a QML Pathology collection room. Walk-ins are welcome subject to doctor availability; booking ahead online is the surest way to be seen, and you can fill your script a few steps away afterwards."
  faqs={faqs}
  hub={{ name: 'Pharmacy services', href: '/pharmacy-services/' }}
  primaryCta={{ label: 'Book a GP', href: hm.bookingUrl, external: true, event: 'cta_book_gp' }}
  secondaryCta={{ label: `Call Help Medical ${hm.phone}`, href: hm.phoneHref, event: 'cta_call_gp' }}
  actionCall={{ href: hm.phoneHref, event: 'cta_call_gp' }}
  actionBook={{ href: hm.bookingUrl, event: 'cta_book_gp' }}
  noServiceSchema
  extraSchema={[helpMedicalNode(), ...doctorNodes]}
  dateModified="2026-10-29"
>
  <h2>Does Help Medical bulk bill?</h2>
  <Image src={receptionImg} alt="Help Medical reception desk and waiting area inside Priceline Pharmacy Pacific Fair" widths={[480, 760]} sizes="(max-width: 760px) 100vw, 760px" />
  <p>Yes. Help Medical bulk bills everyone with a Medicare card. Patients without Medicare, such as overseas visitors, are private patients and pay a fee, so ask about the cost when you book.</p>

  <h2>Do I need an appointment to see a GP?</h2>
  <p>No, but it helps. Help Medical welcomes walk-ins, subject to doctor availability. On busy days appointments fill quickly, so booking ahead is the surest way to be seen. New patients and Gold Coast visitors are welcome.</p>
  <p><a href={hm.bookingUrl} rel="noopener">Book online through HotDoc</a> (the booking system used by Help Medical) or call Help Medical on <a href={hm.phoneHref}>{hm.phone}</a>.</p>

  <h2>What are Help Medical’s opening hours?</h2>
  <dl>
    {hmHours.map((r) => (
      <div>
        <dt>{r.label}</dt>
        <dd>{r.value}</dd>
      </div>
    ))}
  </dl>
  <p>Public holiday hours may differ. Check with the clinic before you visit.</p>

  <h2>What can the GPs help with?</h2>
  <p>Help Medical offers the full range of general practice care, including:</p>
  <ul>
    <li>check-ups, health assessments and same-day illness</li>
    <li>prescriptions, repeat scripts and referrals</li>
    <li>women’s health, contraception and IUD insertion</li>
    <li>men’s health</li>
    <li>antenatal and postnatal care</li>
    <li>children’s and adolescent health</li>
    <li>skin checks and minor skin procedures</li>
    <li>vaccinations and travel health</li>
    <li>mental health care</li>
    <li>chronic disease management</li>
    <li>work medicals and WorkCover</li>
  </ul>

  <h2>Meet the doctors</h2>
  {doctors.map((d) => (
    <section>
      <h3>{d.name}</h3>
      {d.img && <Image src={d.img} alt={`${d.name}, GP at Help Medical, Pacific Fair`} width={240} height={240} />}
      {d.credentials && <p><strong>{d.credentials}</strong></p>}
      {d.languages && <p>Speaks {listJoin(d.languages)}.</p>}
      <p>{d.bio}</p>
      {d.notice && <p><strong>{d.notice}</strong></p>}
    </section>
  ))}

  <h2>Can I get a blood test at Help Medical?</h2>
  <p>Yes. A <a href={site.pathology.url} rel="noopener">{site.pathology.name}</a> collection room operates inside Help Medical, so you can have blood tests and other pathology collected without leaving the centre. Bring your request form from any doctor.</p>
  <p>Collection hours: {site.pathology.hoursText} Phone <a href={site.pathology.phoneHref}>{site.pathology.phone}</a>. See <a href="/blood-tests/">blood tests at Pacific Fair</a> for what to bring, fasting and fees.</p>

  <h2>Can I fill my script straight after seeing the doctor?</h2>
  <p>Yes. Having GPs and pharmacists under one roof means your script can go straight to our dispensary, a few steps away, and our pharmacists can refer you to a doctor quickly if you need one. If you have questions about a new medicine after your appointment, just ask at the counter.</p>
  <p>Taking several medicines? We can pack them into weekly <a href="/medication-packing/">Webster packs</a>, with every dose sorted by day and time and checked by a pharmacist. Packing is free for concession and health care card holders. Ask your GP to send your scripts straight to us, or ask at our prescription counter.</p>

  <h2>Where is Help Medical inside the store?</h2>
  <Image src={entranceImg} alt="The Help Medical entrance and sign inside Priceline Pharmacy Pacific Fair" widths={[480, 760, 1100]} sizes="(max-width: 760px) 100vw, 760px" quality={72} />
  <p>Once you walk into Priceline Pharmacy Pacific Fair, Help Medical is on the right-hand side of the store. See <a href="/visit-us/">parking and directions</a>.</p>
  <p>In an emergency, call 000.</p>
</ServicePage>

<style>
  dl { margin: 0 0 var(--s5); display: grid; gap: 6px; max-width: 420px; }
  dl > div { display: flex; justify-content: space-between; gap: var(--s4); border-bottom: 1px solid var(--hairline); padding-bottom: 6px; }
  dl > div:last-child { border-bottom: 0; }
  dt { font-weight: 600; color: var(--charcoal); }
  dd { margin: 0; text-align: right; white-space: nowrap; }
  section { margin-bottom: var(--s6); }
  section :global(img) { width: 160px; height: 160px; object-fit: cover; border-radius: 50%; margin: var(--s2) 0 var(--s3); display: block; }
</style>
