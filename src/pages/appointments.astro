---
import ContentPage from '../layouts/ContentPage.astro';
import { site } from '../data/site';

const faqs = [
  { q: 'Which services need an appointment?', a: 'Only contraception consultations, because they need a trained pharmacist on duty; please call first. Everything else is walk-in, with online booking optional for vaccinations and pharmacist consultations. Just come in.' },
  { q: 'How do I book online?', a: `Use our online booking page at <a href="${site.links.book}" rel="noopener">MedAdvisor</a>, choose the service and pick a time. You can also scan the QR code at the counter to join the queue for a vaccination.` },
  { q: 'How do I book a doctor?', a: `<a href="/help-medical/">Help Medical</a>, an independent general practice located inside our store, takes bookings at <a href="${site.helpMedical.bookingUrl}" rel="noopener">helpmedical.au</a> or on <a href="${site.helpMedical.phoneHref}">${site.helpMedical.phone}</a>. Walk-ins are welcome subject to doctor availability.` },
  { q: 'Can I just walk in for a vaccination?', a: 'Yes. We welcome walk-ins every day we’re open; scan the QR code at the counter to join the queue. Booking a time is optional and handy if you’d rather not wait.' },
];
---

<ContentPage
  title="Book Online or Walk In | Priceline Pharmacy Pacific Fair"
  description="How to book a vaccination, contraception consultation, pharmacist consult or GP appointment at Priceline Pacific Fair, Broadbeach. Most services are walk-in."
  path="/appointments/"
  h1="Book an appointment"
  lead="Most services at Priceline Pharmacy Pacific Fair in Broadbeach are walk-in, so you can just come in. Vaccinations and pharmacist consultations can be booked online if you’d prefer a set time, contraception consultations are booked by phone, and GP appointments are made directly with Help Medical. Here’s how to book each service."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Appointments', href: '/appointments/' }]}
  faqs={faqs}
  showNap
  dateModified="2026-10-07"
>
  <div class="btn-row">
    <a class="btn btn--primary" href={site.links.book} rel="noopener" data-event="book">Book online</a>
    <a class="btn btn--secondary" href={site.phoneHref} data-event="call">Call {site.phone}</a>
  </div>

  <h2>How to book each service</h2>
  <div class="table-wrap table-wrap--stack">
    <table>
      <thead>
        <tr><th scope="col">Service</th><th scope="col">Booking</th><th scope="col">How</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><a href="/vaccination-information/">Vaccinations</a></td>
          <td data-label="Booking">Walk in, or book</td>
          <td data-label="How"><a href={site.links.book} rel="noopener">Book online</a>, or scan the QR code at the counter to join the queue.</td>
        </tr>
        <tr>
          <td>Pharmacist consultations and health checks</td>
          <td data-label="Booking">Walk in, or book</td>
          <td data-label="How"><a href={site.links.book} rel="noopener">Book online</a>, or ask at the counter.</td>
        </tr>
        <tr>
          <td><a href="/hormonal-contraceptive-pill/">Contraception consultations</a></td>
          <td data-label="Booking">Book by phone</td>
          <td data-label="How">Call <a href={site.phoneHref}>{site.phone}</a> to book.</td>
        </tr>
        <tr>
          <td><a href="/uti-treatment/">UTI treatment</a></td>
          <td data-label="Booking">Walk in</td>
          <td data-label="How">Ask for a trained pharmacist at the prescription counter. No booking needed.</td>
        </tr>
        <tr>
          <td><a href="/emergency-contraception/">Emergency contraception</a></td>
          <td data-label="Booking">Walk in</td>
          <td data-label="How">Ask at the counter. We’ll talk with you privately.</td>
        </tr>
        <tr>
          <td><a href="/help-medical/">GP at Help Medical</a></td>
          <td data-label="Booking">Walk in, or book</td>
          <td data-label="How">Book at <a href={site.helpMedical.bookingUrl} rel="noopener">helpmedical.au</a> or call <a href={site.helpMedical.phoneHref}>{site.helpMedical.phone}</a>.</td>
        </tr>
        <tr>
          <td><a href="/medication-reviews/">Medication reviews</a></td>
          <td data-label="Booking">No booking needed</td>
          <td data-label="How">Just ask a pharmacist.</td>
        </tr>
        <tr>
          <td><a href="/quit-smoking/">Quit smoking</a></td>
          <td data-label="Booking">Walk in</td>
          <td data-label="How">Ask at the counter, or call ahead for a longer chat.</td>
        </tr>
        <tr>
          <td><a href="/ear-piercings/">Ear piercing</a></td>
          <td data-label="Booking">Walk in</td>
          <td data-label="How">Come in during opening hours. Under-16s need a parent or guardian.</td>
        </tr>
        <tr>
          <td><a href="/passport-photos/">Passport photos</a></td>
          <td data-label="Booking">Walk in</td>
          <td data-label="How">No booking needed.</td>
        </tr>
        <tr>
          <td><a href="/health-station/">Blood pressure and health checks</a></td>
          <td data-label="Booking">Walk in</td>
          <td data-label="How">Use the Health Station in store any time we’re open.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Not sure what you need?</h2>
  <p>Ask a pharmacist. There’s no appointment needed. Call <a href={site.phoneHref}>{site.phone}</a> or come and see us. <a href="/visit-us/">Opening hours and directions</a>.</p>
</ContentPage>
