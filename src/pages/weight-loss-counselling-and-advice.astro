---
import ServicePage from '../layouts/ServicePage.astro';
import { Image } from 'astro:assets';
import photo from '../assets/images/weight-management-shelves.jpg';
import { site } from '../data/site';
import { serviceBySlug } from '../data/services';
const service = serviceBySlug('weight-loss-counselling-and-advice')!;

const faqs = [
  { q: 'Is weight management support free?', a: 'Yes. Our pharmacists’ support and advice is free, and you don’t need to book. Just ask at the counter.' },
  { q: 'Do I need to book?', a: 'No. Ask at the counter any time we’re open and a pharmacist will talk with you privately.' },
  { q: 'Can you track my weight and blood pressure?', a: 'Yes. We can record your weight, BMI and blood pressure at our in-store Health Station and email you the results, so you can see your progress over time. Check in each time you visit.' },
  { q: 'Do you work with a dietitian?', a: 'Yes. We work with a local dietitian and can put you in touch if you’d like tailored nutrition advice. Ask at the counter.' },
  { q: 'When should I see my GP instead?', a: 'See your doctor if you have unexplained weight loss or gain, a health condition such as diabetes or heart disease, or if you’re pregnant or planning a pregnancy. In an emergency, call 000.' },
];
---

<ServicePage
  service={service}
  title="Free Weight Management Support | Priceline Pacific Fair"
  description="Free, private weight management support from pharmacists at Priceline Pacific Fair, Broadbeach: health checks, practical advice and a local dietitian."
  h1="Weight management support at Pacific Fair"
  lead="Yes, our pharmacists at Priceline Pharmacy Pacific Fair in Broadbeach offer free, private one-on-one weight management support. We can track your weight, BMI and blood pressure at our in-store Health Station and put you in touch with a local dietitian. No booking is needed; just ask at the counter."
  faqs={faqs}
  primaryCta={{ label: `Call ${site.phone}`, href: site.phoneHref, event: 'cta_call' }}
  secondaryCta={{ label: 'Hours & directions', href: '/visit-us/' }}
  dateModified="2026-10-28"
>
  <h2>How can our pharmacists help?</h2>
  <ul>
    <li><strong>A private conversation.</strong> We talk through your goals, your current medicines and anything that has made weight management harder in the past.</li>
    <li><strong>Free health checks.</strong> We can record your weight, BMI and blood pressure at our in-store <a href="/health-station/">Health Station</a> and email you the results, so you can see your progress over time.</li>
    <li><strong>Practical advice.</strong> We cover eating patterns, activity you can realistically keep up, sleep, and staying hydrated in the Gold Coast heat.</li>
    <li><strong>A local dietitian.</strong> We work with a local dietitian and can put you in touch if you’d like tailored nutrition advice.</li>
  </ul>

  <Image src={photo} alt="Meal replacement shakes, vitamins and weight management products on the shelves at Priceline Pharmacy Pacific Fair" widths={[480, 760]} sizes="(max-width: 760px) 100vw, 760px" quality={60} />

  <h2>Who is this service for?</h2>
  <p>Anyone who wants support managing their weight, whether you’re just getting started, restarting after a break, or already under the care of a doctor or dietitian. We’ll work alongside your other health professionals, not replace them.</p>

  <h2>How much does weight management support cost?</h2>
  <p>Nothing. Our pharmacists’ support and advice is free, and you don’t need to book. Just ask at the counter, or call us on <a href={site.phoneHref}>{site.phone}</a> if you have a question first.</p>

  <h2>When should I see my GP?</h2>
  <p>See your doctor if you have unexplained weight loss or gain, if you have a health condition such as diabetes or heart disease, or if you’re pregnant or planning a pregnancy. In an emergency, call 000.</p>
</ServicePage>
