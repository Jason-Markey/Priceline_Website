---
import ServicePage from '../layouts/ServicePage.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { serviceBySlug } from '../data/services';
import passportImg from '../assets/images/passport-photos.jpg';
const service = serviceBySlug('passport-photos')!;

const faqs = [
  { q: 'How much do passport photos cost?', a: 'Passport and visa photos are $25, taken and printed while you wait, with digital copies included.' },
  { q: 'Do I need to book for passport photos?', a: 'No. Come in any time we’re open and we’ll take your photos while you wait. It usually takes about 10 minutes.' },
  { q: 'Can you take photos for overseas passports and visas?', a: 'Yes. Tell us which country or visa the photo is for and we’ll set up the right format and size.' },
  { q: 'Can you take passport photos for children?', a: 'Yes, for children aged 5 and over. For younger children, ask us and we’ll let you know what’s possible.' },
  { q: 'Can I wear glasses in my passport photo?', a: 'No. Australian passports don’t accept photos with glasses, so please take them off for the photo.' },
  { q: 'Do I get a digital copy?', a: 'Yes. You receive printed photos and digital copies, which is handy for online applications.' },
];
---

<ServicePage
  service={service}
  title="Passport Photos Pacific Fair, Broadbeach | $25, No Booking"
  description="Australian and overseas passport and visa photos taken while you wait at Priceline Pacific Fair, Broadbeach. $25, ages 5 and over, no appointment needed."
  h1="Passport and visa photos at Pacific Fair"
  lead="Need passport photos in a hurry? Pop into Priceline Pharmacy Pacific Fair in Broadbeach any time we’re open and we’ll take your passport or visa photos while you wait. $25, for ages 5 and over, with printed and digital copies and no appointment needed."
  faqs={faqs}
  hub={{ name: 'Beauty & everyday', href: '/beauty-fragrance/' }}
  primaryCta={{ label: `Call ${site.phone}`, href: site.phoneHref, event: 'call' }}
  secondaryCta={{ label: 'Hours & directions', href: '/visit-us/' }}
  dateModified="2026-10-07"
>
  <h2>How much do passport photos cost?</h2>
  <Image src={passportImg} alt="Passport photos being taken at Priceline Pharmacy Pacific Fair" widths={[480, 760]} sizes="(max-width: 760px) 100vw, 760px" />
  <p>Passport and visa photos cost <strong>$25</strong>. Come in any time during our <a href="/visit-us/">opening hours</a> and we’ll take your photo while you wait.</p>
  <ul>
    <li>No appointment needed</li>
    <li>Australian and overseas passport and visa photos</li>
    <li>Ages 5 and above</li>
    <li>Printed and digital copies of your photos</li>
  </ul>

  <h2>Do I need to book?</h2>
  <p>No. Walk in any day we’re open, including until 9pm on Thursdays, and allow about 10 minutes.</p>

  <h2>Can you do photos for other countries’ passports and visas?</h2>
  <p>Yes. Applying for another country’s passport or visa? Tell us which one and we’ll set up the right format. For Australian passports, see the full requirements at the <a href="https://www.passports.gov.au/" rel="noopener">Australian Passport Office</a>.</p>

  <h2>How do I get a photo that’s accepted first time?</h2>
  <ul>
    <li><strong>Neutral expression</strong>, with your mouth closed and eyes open.</li>
    <li><strong>No glasses:</strong> Australian passports don’t accept photos with glasses.</li>
    <li><strong>Face uncovered:</strong> hair away from your eyes and no hats. Religious head coverings are fine if your full face is visible.</li>
    <li><strong>Plain clothing</strong> that contrasts with a light background.</li>
    <li><strong>Recent:</strong> photos must be taken within the last six months.</li>
  </ul>

  <h2>Travelling soon?</h2>
  <p>See our <a href="/travel-health/">travel health advice and travel vaccines</a>, or ask our pharmacists about a travel health kit.</p>
</ServicePage>
