---
/**
 * Dynamic route: every file in src/content/articles becomes /<slug>/ (same URLs as the old WordPress posts).
 */
import { render } from 'astro:content';
import ServiceCallout from '../components/ServiceCallout.astro';
import { serviceBySlug } from '../data/services';
import { getLiveArticles, byNewest } from '../lib/articles';
import ArticlePage from '../layouts/ArticlePage.astro';

export async function getStaticPaths() {
  const all = await getLiveArticles();
  return all.map((entry) => ({
    params: { article: entry.id.replace(/\.md$/, '') },
    props: {
      entry,
      // Related: tag overlap counts double, same category counts once; best score first, then newest.
      related: all
        .filter((o) => o.id !== entry.id)
        .map((o) => ({
          o,
          score: o.data.tags.filter((t) => entry.data.tags.includes(t)).length * 2 + (o.data.category === entry.data.category ? 1 : 0),
        }))
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score || byNewest(a.o, b.o))
        .slice(0, 5)
        .map((r) => r.o),
    },
  }));
}
const { entry, related } = Astro.props;
const { Content } = await render(entry);
// A link to the article's main service goes straight after the opening answer (ServiceCallout.astro). The body is
// split after its first paragraph; articles have no images or components in the body, so the rendered HTML is complete.
const html = entry.rendered?.html ?? '';
const cut = html.indexOf('</p>');
const service = entry.data.relatedServices[0] ? serviceBySlug(entry.data.relatedServices[0]) : undefined;
---
<ArticlePage entry={entry} related={related}>
  {service && cut > -1 ? (
    <Fragment>
      <Fragment set:html={html.slice(0, cut + 4)} />
      <ServiceCallout service={service} />
      <Fragment set:html={html.slice(cut + 4)} />
    </Fragment>
  ) : <Content />}
</ArticlePage>
