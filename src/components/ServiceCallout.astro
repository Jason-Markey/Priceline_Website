---
/**
 * A short link to the article's main service, placed straight after the opening answer ([article].astro).
 * October 2026 data: the closing call-to-action box in articles got no clicks, while the buttons on the service pages
 * got the most, so this sends readers who want the service to the page that has the booking and call buttons.
 */
import type { Service } from '../data/services';

export interface Props { service: Service; }
const { service: s } = Astro.props;
---

<aside class="svc-callout" data-cta-location="article_callout" aria-label={`${s.name} at our Pacific Fair store`}>
  <p class="svc-callout__eyebrow">At our Pacific Fair store</p>
  <p class="svc-callout__name">{s.name}</p>
  <p class="svc-callout__text">{s.short} <a href={`/${s.slug}/`} data-event="service-link">See how it works<span aria-hidden="true">&nbsp;→</span></a></p>
</aside>

<style>
  .svc-callout { margin: var(--s6) 0 var(--s8); padding: var(--s4) var(--s5); background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--pink); border-radius: var(--radius); box-shadow: var(--shadow); }
  .svc-callout p { margin: 0; }
  .svc-callout__eyebrow { font-size: 0.8125rem; font-weight: 600; letter-spacing: .02em; color: var(--pink-deep); }
  .svc-callout__name { font-weight: 700; color: var(--charcoal); font-size: var(--fs-lg); line-height: 1.3; margin-top: 2px !important; }
  .svc-callout__text { font-size: var(--fs-sm); color: var(--text); margin-top: var(--s1) !important; }
  .svc-callout a { font-weight: 600; white-space: nowrap; }
</style>
