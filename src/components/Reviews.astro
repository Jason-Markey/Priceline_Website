---
/**
 * Google reviews block. context 'home': rating rail + the first three reviews (a swipe row on phones).
 * context 'page': rating header + the lead review as a featured card + the rest in two balanced columns.
 * Reviews, rating and the rules for choosing reviews: src/data/reviews.ts. No review schema on purpose.
 */
import ReviewCard from './ReviewCard.astro';
import { reviews, googleRating, reviewsPreview, type Review } from '../data/reviews';
import { site } from '../data/site';

export interface Props { context?: 'home' | 'page'; }
const { context = 'page' } = Astro.props;

const isTall = (r: Review) => r.text.length > 180;
const isShort = (r: Review) => r.text.length < 120;

// Homepage: three cards. When one is long and two are short, the long one gets a column to itself and the two short
// ones stack beside it, so the row doesn't leave big gaps under the short reviews.
const first3 = reviews.slice(0, 3);
const tall3 = first3.filter(isTall);
const split = first3.length === 3 && tall3.length === 1 && first3.filter(isShort).length === 2;
const homeCards = split ? [tall3[0], ...first3.filter((r) => r !== tall3[0])] : first3;

// /reviews/: the lead review full width, then the rest in two columns of similar height. Every way of splitting them
// is tried (there are only a handful), using a rough card height; each column runs longest first.
const lead = reviews.find((r) => r.lead) ?? reviews[0];
const estHeight = (r: Review) => 140 + 26 * (Math.ceil(r.text.length / 60) + r.text.split('\n').length - 1);
const balance = (cards: Review[]): Review[][] => {
  const sorted = [...cards].sort((x, y) => y.text.length - x.text.length);
  if (sorted.length > 14) return [sorted.filter((_, i) => i % 2 === 0), sorted.filter((_, i) => i % 2 === 1)];
  let best: Review[][] = [sorted, []];
  let bestScore = Infinity;
  // Even masks only: the longest review always starts the first column
  const total = 2 ** sorted.length;
  for (let mask = 0; mask < total; mask += 2) {
    const cols: Review[][] = [[], []];
    sorted.forEach((r, i) => cols[Math.floor(mask / 2 ** i) % 2].push(r));
    const h = cols.map((c) => c.reduce((t, r) => t + estHeight(r) + 16, 0));
    const score = Math.max(h[0], h[1]) * 1000 + Math.abs(h[0] - h[1]);
    if (score < bestScore) { bestScore = score; best = cols; }
  }
  return best;
};
const stacks = context === 'page' ? balance(reviews.filter((r) => r !== lead)).filter((c) => c.length > 0) : [];

// Preview builds only: empty slots show where reviews will go until there are enough real ones
const shown = context === 'home' ? homeCards.length : reviews.length;
const slots = reviewsPreview ? Math.max(0, (context === 'home' ? 3 : 4) - shown) : 0;
const hasRating = googleRating.count > 0;
const score = hasRating ? googleRating.rating.toFixed(1) : '';
// The overall rating's stars fill to the actual score (4.6 shows four and a bit), as on Google
const fill = hasRating ? Math.round((googleRating.rating / 5) * 1000) / 10 : 100;
const star = 'M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z';
const five = [1, 2, 3, 4, 5];
---

<div class:list={['rv', `rv--${context}`]}>
  {context === 'home' ? (
    <div class="rv__rail">
      {hasRating ? <p class="rv__score">{score}</p> : <p class="rv__score rv__score--empty">Rating</p>}
      <span class="rv__rating" role="img" aria-label={hasRating ? `Rated ${score} out of 5` : 'Rating'}>
        <span class="rv__rating-base">{five.map(() => <svg viewBox="0 0 24 24" aria-hidden="true"><path d={star} /></svg>)}</span>
        <span class="rv__rating-fill" style={`width:${fill}%`}>{five.map(() => <svg viewBox="0 0 24 24" aria-hidden="true"><path d={star} /></svg>)}</span>
      </span>
      <p class="rv__meta">
        {hasRating
          ? <Fragment>Rated <b>{score}</b> from <b>{googleRating.count}</b> Google reviews</Fragment>
          : 'Your Google rating and review count go here'}
      </p>
      <a class="rv__more" href="/reviews/">Read more reviews</a>
    </div>
  ) : (
    <div class="rv__head">
      <div class="rv__headscore">
        {hasRating ? <p class="rv__score">{score}</p> : <p class="rv__score rv__score--empty">Rating</p>}
        <span class="rv__rating" role="img" aria-label={hasRating ? `Rated ${score} out of 5` : 'Rating'}>
          <span class="rv__rating-base">{five.map(() => <svg viewBox="0 0 24 24" aria-hidden="true"><path d={star} /></svg>)}</span>
          <span class="rv__rating-fill" style={`width:${fill}%`}>{five.map(() => <svg viewBox="0 0 24 24" aria-hidden="true"><path d={star} /></svg>)}</span>
        </span>
      </div>
      <div>
        <p class="rv__headline">
          {hasRating ? `Rated ${score} from ${googleRating.count} Google reviews` : 'Your Google rating and review count go here'}
        </p>
        <p class="rv__sub">A selection of our Google reviews, shown exactly as written. <a href={site.links.googleReviews} rel="noopener">Read them all on Google</a>.</p>
      </div>
    </div>
  )}

  {context === 'home' ? (
    <ul class:list={['rv__cards', { 'rv__cards--split': split }]} role="list">
      {homeCards.map((r) => <ReviewCard review={r} tall={split && isTall(r)} />)}
      {Array.from({ length: slots }).map(() => <li class="rv-slot"><p>Space for a review from your screenshots</p></li>)}
    </ul>
  ) : (
    <Fragment>
      {lead && <ul class="rv__cards" role="list"><ReviewCard review={lead} lead /></ul>}
      <div class="rv__stacks">
        {stacks.map((col) => <ul class="rv__stack" role="list">{col.map((r) => <ReviewCard review={r} />)}</ul>)}
      </div>
      {slots > 0 && <ul class="rv__cards rv__cards--slots" role="list">{Array.from({ length: slots }).map(() => <li class="rv-slot"><p>Space for a review from your screenshots</p></li>)}</ul>}
    </Fragment>
  )}
</div>

<style>
  .rv { --rv-star: var(--pink); --rv-star-off: #ead9e1; }
  .rv__rating { position: relative; display: inline-flex; vertical-align: middle; }
  .rv__rating-base, .rv__rating-fill { display: inline-flex; gap: 2px; }
  .rv__rating-base { color: var(--rv-star-off); }
  .rv__rating-fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; color: var(--rv-star); white-space: nowrap; }
  .rv__rating svg { flex: 0 0 20px; width: 20px; height: 20px; fill: currentColor; }
  .rv__score { font-size: 3.5rem; font-weight: 800; line-height: 1; color: var(--charcoal); letter-spacing: -0.02em; margin: 0 0 var(--s2); }
  .rv__score--empty { font-size: 1.75rem; color: var(--text-muted); font-weight: 700; }

  /* Home: rating rail beside three cards */
  .rv--home { display: grid; gap: var(--s6); }
  @media (min-width: 900px) { .rv--home { grid-template-columns: 240px 1fr; gap: var(--s8); align-items: start; } }
  .rv__meta { font-size: var(--fs-sm); color: var(--text-muted); margin: var(--s3) 0 var(--s4); }
  .rv__meta b { color: var(--charcoal); }
  .rv__more { font-weight: 600; text-decoration: none; }
  .rv__more::after { content: ' →'; }
  .rv__more:hover { text-decoration: underline; }
  @media (max-width: 899px) {
    /* Phones and tablets: the rail becomes one line above the cards */
    .rv--home .rv__rail { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--s3); row-gap: var(--s1); }
    .rv--home .rv__score { font-size: 2.25rem; margin: 0; }
    .rv--home .rv__meta { margin: 0; flex-basis: 100%; }
    .rv--home .rv__more { flex-basis: 100%; }
  }

  /* Page: rating header */
  .rv__head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s4) var(--s6); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); padding: var(--s6); margin-bottom: var(--s6); }
  .rv__headscore { display: flex; align-items: center; gap: var(--s3); }
  .rv__headscore .rv__score { margin: 0; }
  .rv__headline { font-size: var(--fs-lg); font-weight: 700; color: var(--charcoal); margin: 0; }
  .rv__sub { font-size: var(--fs-sm); color: var(--text-muted); margin: var(--s1) 0 0; }

  /* Cards */
  .rv__cards, .rv__stack { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }
  .rv--home .rv__cards { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .rv__stacks { display: grid; gap: var(--s4); margin-top: var(--s4); align-items: start; }
  @media (min-width: 640px) { .rv__stacks { grid-template-columns: 1fr 1fr; } }
  .rv__cards--slots { margin-top: var(--s4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .rv-slot { display: flex; align-items: center; justify-content: center; min-height: 180px; border: 2px dashed #e4c3d3; border-radius: var(--radius-lg); padding: var(--s6); text-align: center; }
  .rv-slot p { margin: 0; color: var(--text-muted); font-style: italic; font-size: var(--fs-sm); }

  /* Homepage, one long review beside two short ones: two columns, the long card spanning both rows */
  @media (min-width: 640px) {
    .rv--home .rv__cards--split { grid-template-columns: 1fr 1fr; }
    .rv__cards--split :global(.rv-card--tall) { grid-row: span 2; }
  }

  /* Phones: the homepage cards become one swipe row, with the next card peeking in. A long review is left out of the
     row (it's on /reviews/), because one tall card would stretch the row and leave gaps under the short ones. */
  @media (max-width: 639px) {
    .rv--home .rv__cards { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter)); padding: 0 var(--gutter) var(--s2); scroll-padding-inline: var(--gutter); align-items: flex-start; }
    .rv--home .rv__cards::-webkit-scrollbar { display: none; }
    .rv--home .rv__cards :global(.rv-card) { flex: 0 0 85%; scroll-snap-align: start; }
    .rv--home .rv__cards--split :global(.rv-card--tall) { display: none; }
  }
</style>
