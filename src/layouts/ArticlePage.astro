---
/**
 * Article template (PLAN §5 #7): title band → category chip + reviewer panel → lead → body → sources → disclaimer → CTA → related.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import TitleBand from '../components/TitleBand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';
import { categories } from '../data/categories';
import { serviceBySlug, type Service } from '../data/services';
import { articleNode } from '../lib/schema';
import jason from '../assets/images/jason-pharmacist-portrait.jpg';

export interface Props {
  entry: CollectionEntry<'articles'>;
  related: CollectionEntry<'articles'>[];
}
const { entry, related } = Astro.props;
const d = entry.data;
const slug = entry.id.replace(/\.md$/, '');
const path = `/${slug}/`;
const url = `${site.url}${path}`;
const cat = categories[d.category];
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Advice', href: '/health-blog/' },
  { name: cat.name, href: `/category/${d.category}/` },
  { name: d.title, href: path },
];
const fmt = (dt: Date) => dt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Australia/Brisbane' });
const relatedServices = d.relatedServices.map(serviceBySlug).filter(Boolean) as Service[];
const schema = [
  articleNode({
    url, title: d.title, description: d.description,
    datePublished: d.publishDate.toISOString().slice(0, 10),
    dateModified: d.modifiedDate.toISOString().slice(0, 10),
    section: cat.name, keywords: d.tags, citations: d.references,
  }),
];
---

<Base
  title={d.seoTitle ?? `${d.title} | ${site.shortName}`}
  description={d.description}
  path={path}
  breadcrumbs={breadcrumbs}
  schema={schema}
  pageType="Article"
  datePublished={d.publishDate.toISOString().slice(0, 10)}
  dateModified={d.modifiedDate.toISOString().slice(0, 10)}
>
  <TitleBand title={d.title} breadcrumbs={breadcrumbs} />

  <div class="container article-layout">
    <article class="prose">
      <p class="meta">
        <a class="chip" href={`/category/${d.category}/`}>{cat.name}</a>
        <span class="meta__dot" aria-hidden="true">·</span><span>Published <time datetime={d.publishDate.toISOString().slice(0, 10)}>{fmt(d.publishDate)}</time></span>
        <span class="meta__dot" aria-hidden="true">·</span><span>Reviewed <time datetime={d.modifiedDate.toISOString().slice(0, 10)}>{fmt(d.modifiedDate)}</time></span>
      </p>

      <div class="reviewer">
        <Image src={jason} alt="" width={64} height={128} class="reviewer__photo" />
        <div>
          <p class="reviewer__line"><strong>Written by the {site.name} team.</strong> Reviewed by <a href="/about-us/">{site.reviewer.name}</a>, {site.reviewer.credentials}, {site.reviewer.role}.</p>
          <p class="reviewer__sub">General health information from a registered pharmacist. It doesn’t replace advice from your own pharmacist or doctor.</p>
        </div>
      </div>

      <slot />

      {d.references.length > 0 && (
        <section class="sources" aria-labelledby="sources-h">
          <h2 id="sources-h">Sources</h2>
          <ul>{d.references.map((r) => <li><a href={r.url} rel="noopener">{r.name}</a></li>)}</ul>
        </section>
      )}

      <p class="disclaimer">This article is general information only and isn’t a substitute for personal advice from your doctor or pharmacist. Always read the label and follow the directions for use. If symptoms persist or you’re worried, talk to your pharmacist or GP. In an emergency, call 000.</p>

      <div class="cta card" data-cta-location="article_cta">
        <h2>Talk to our pharmacists at Pacific Fair</h2>
        <p>Pop in, no appointment needed. We’re on the ground floor of Pacific Fair Shopping Centre, Broadbeach, open 7 days and until 9pm on Thursdays.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={site.phoneHref} data-event="call">Call {site.phone}</a>
          <a class="btn btn--secondary" href="/visit-us/">Hours &amp; directions</a>
        </div>
      </div>
    </article>

    <aside class="article-side">
      {relatedServices.length > 0 && (
        <section aria-labelledby="rs-h">
          <h2 id="rs-h">Related services</h2>
          <div class="side-list">{relatedServices.map((s) => <ServiceCard service={s} />)}</div>
        </section>
      )}
      {related.length > 0 && (
        <section aria-labelledby="ra-h">
          <h2 id="ra-h">More advice</h2>
          <ul class="more">
            {related.map((r) => <li><a href={`/${r.id.replace(/\.md$/, '')}/`}>{r.data.title}</a></li>)}
          </ul>
        </section>
      )}
      <section aria-labelledby="az-h">
        <h2 id="az-h">Quick answers</h2>
        <ul class="more">
          <li><a href="/common-illness-information/">Common illnesses A–Z</a></li>
          <li><a href="/frequently-asked-questions/">Frequently asked questions</a></li>
        </ul>
      </section>
    </aside>
  </div>
</Base>

<style>
  .article-layout > * { min-width: 0; }
  .article-layout { display: grid; gap: var(--s10); padding-block: var(--s10) var(--s12); }
  @media (min-width: 1024px) { .article-layout { grid-template-columns: minmax(0, var(--measure)) 320px; gap: var(--s16); } }
  .meta { font-size: var(--fs-sm); color: var(--text-muted); margin-bottom: var(--s5); line-height: 1.8; }
  .meta .chip { vertical-align: 1px; }
  .meta__dot { margin: 0 var(--s2); }
  .reviewer { display: flex; gap: var(--s4); align-items: flex-start; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--s4) var(--s5); margin-bottom: var(--s8); }
  .reviewer__photo { width: 56px; height: 56px; object-fit: cover; object-position: top; border-radius: 50%; flex: 0 0 auto; }
  .reviewer__line { margin: 0 0 var(--s1); font-size: var(--fs-sm); }
  .reviewer__sub { margin: 0; font-size: 0.875rem; color: var(--text-muted); }
  .prose :global(h2) { color: var(--pink-deep); }
  .sources { margin-top: var(--s10); }
  .sources h2 { font-size: 1.125rem; color: var(--charcoal); }
  .sources ul { font-size: var(--fs-sm); }
  /* CTA card: pale pink surface, no border (the 4px pink border is reserved for information panels) */
  .cta { margin-top: var(--s8); background: var(--pink-pale); border: 0; }
  .cta h2 { margin-top: 0; font-size: 1.375rem; color: var(--charcoal); }
  .cta .btn-row { margin-bottom: 0; }
  .article-side h2 { font-size: 1.0625rem; margin: var(--s6) 0 var(--s3); }
  .article-side section:first-child h2 { margin-top: 0; }
  .side-list { display: grid; gap: var(--s3); }
  .more { list-style: none; padding: 0; margin: 0; font-size: var(--fs-sm); }
  .more li { padding: var(--s2) 0; border-bottom: 1px solid var(--hairline); }
</style>
