---
/**
 * Service page template (PLAN §5 #3).
 * title band → lead (direct answer) → At a glance → CTA row → body (slot) → FAQs → related → NAP → disclaimer
 */
import Base from './Base.astro';
import TitleBand from '../components/TitleBand.astro';
import AtAGlance from '../components/AtAGlance.astro';
import Faq from '../components/Faq.astro';
import Nap from '../components/Nap.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';
import { serviceBySlug, type Service } from '../data/services';
import { serviceNode, faqNode } from '../lib/schema';
import { getLiveArticles, slugOf } from '../lib/articles';

export interface Props {
  service: Service;
  title: string;
  description: string;
  h1?: string;
  lead: string;
  hub?: { name: string; href: string };
  faqs?: { q: string; a: string }[];
  primaryCta?: { label: string; href: string; external?: boolean; event?: string };
  secondaryCta?: { label: string; href: string; external?: boolean; event?: string };
  bookHref?: string;
  disclaimer?: string;
  ogImage?: ImageMetadata;
  dateModified?: string;
  /** Extra JSON-LD nodes (e.g. helpMedicalNode()) */
  extraSchema?: Record<string, unknown>[];
  /** Hide the Service schema node (for partner pages) */
  noServiceSchema?: boolean;
}

const {
  service, title, description, h1, lead,
  hub = { name: 'Pharmacy services', href: '/pharmacy-services/' },
  faqs = [],
  primaryCta = { label: `Call ${site.phone}`, href: site.phoneHref, event: 'call' },
  secondaryCta = { label: 'Hours & directions', href: '/visit-us/' },
  bookHref,
  disclaimer = 'This information is general in nature and isn’t a substitute for personal advice from your pharmacist or doctor.',
  ogImage, dateModified, extraSchema = [], noServiceSchema = false,
} = Astro.props;

const path = `/${service.slug}/`;
const reviewedDate = dateModified ? new Date(dateModified).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Australia/Brisbane' }) : undefined;
const url = `${site.url}${path}`;
const breadcrumbs = [{ name: 'Home', href: '/' }, hub, { name: service.name, href: path }];
const related = service.related.map(serviceBySlug).filter(Boolean) as Service[];
// Pharmacist articles that list this service in relatedServices: the service named first counts most, then newest.
const advice = (await getLiveArticles())
  .filter((a) => a.data.relatedServices.includes(service.slug))
  .sort((a, b) => a.data.relatedServices.indexOf(service.slug) - b.data.relatedServices.indexOf(service.slug)
    || b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 5);
const schema = [
  ...(noServiceSchema ? [] : [serviceNode({ url, name: service.name, description: service.short, price: service.price })]),
  ...(faqs.length ? [faqNode(faqs.map((f) => ({ q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))] : []),
  ...extraSchema,
];
---

<Base title={title} description={description} path={path} breadcrumbs={breadcrumbs} schema={schema} ogImage={ogImage} dateModified={dateModified}>
  <TitleBand title={h1 ?? service.name} breadcrumbs={breadcrumbs} />
  <div class="container svc-layout">
    <article class="prose">
      <p class="lead">{lead}</p>
      {reviewedDate && <p class="reviewed">Reviewed by {site.reviewer.name}, {site.reviewer.role.toLowerCase()} · Updated {reviewedDate}</p>}
      <div class="btn-row" data-cta-location="service_cta">
        <a class="btn btn--primary" href={primaryCta.href} rel={primaryCta.external ? 'noopener' : undefined} data-event={primaryCta.event}>{primaryCta.label}</a>
        <a class="btn btn--secondary" href={secondaryCta.href} rel={secondaryCta.external ? 'noopener' : undefined} data-event={secondaryCta.event}>{secondaryCta.label}</a>
      </div>
      <div class="glance-mobile"><AtAGlance service={service} bookHref={bookHref} /></div>
      <slot />
      {faqs.length > 0 && <Faq items={faqs} />}
      {advice.length > 0 && (
        <section class="advice" aria-labelledby="advice-h">
          <h2 id="advice-h">Related advice</h2>
          <ul class="advice__list">
            {advice.map((a) => <li><a href={`/${slugOf(a)}/`}>{a.data.title}</a></li>)}
          </ul>
        </section>
      )}
      <Nap />
      <p class="disclaimer">{disclaimer}</p>
    </article>
    <aside class="svc-side">
      <div class="svc-side__sticky">
        <div class="glance-desktop"><AtAGlance service={service} bookHref={bookHref} /></div>
        {related.length > 0 && (
          <section class="related" aria-labelledby="related-h">
            <h2 id="related-h">Related services</h2>
            <div class="related__list">{related.map((r) => <ServiceCard service={r} />)}</div>
          </section>
        )}
      </div>
    </aside>
  </div>
</Base>

<style>
  .svc-layout > * { min-width: 0; }
  .svc-layout { display: grid; gap: var(--s10); padding-block: var(--s10) var(--s12); }
  @media (min-width: 1024px) { .svc-layout { grid-template-columns: minmax(0, var(--measure)) 340px; gap: var(--s16); } }
  .glance-desktop { display: none; }
  /* Desktop: the whole sidebar (At a glance + Related) sticks and scrolls within the viewport if taller than it */
  @media (min-width: 1024px) {
    .glance-desktop { display: block; }
    .glance-mobile { display: none; }
    .svc-side__sticky { position: sticky; top: var(--s5); max-height: calc(100vh - 40px); overflow: auto; }
  }
  .reviewed { font-size: var(--fs-sm); color: var(--text-muted); margin: calc(-1 * var(--s3)) 0 var(--s5); }
  .related h2 { font-size: 1.0625rem; margin: var(--s8) 0 var(--s3); }
  .glance-desktop + .related h2 { margin-top: 0; }
  .related__list { display: grid; gap: var(--s3); }
  .advice { margin-top: var(--s10); }
  .advice__list { list-style: none; padding: 0; margin: 0; }
  .advice__list li { padding: var(--s3) 0; border-bottom: 1px solid var(--hairline); }
  .advice__list li:first-child { border-top: 1px solid var(--hairline); }
</style>
