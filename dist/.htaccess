# Priceline Pharmacy Pacific Fair — static site (Astro). Apache / LiteSpeed on VentraIP cPanel.
# Deployed with dist/ by .cpanel.yml. Edit in the repo (public/.htaccess), not on the server.

Options -Indexes

# --- VentraIP ModSecurity: rule 700071 returned HTTP 418 to Anthropic's crawlers (ClaudeBot, Claude-SearchBot,
# Claude-User). VentraIP support (ticket VIP-U9274329, 7 Oct 2026) whitelisted it with this block. It must stay here
# because every deploy overwrites .htaccess with this file.
<IfModule security2_module>
SecRuleRemoveById 700071
</IfModule>
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Canonical host + HTTPS (NOTE: staging runs on new.pricelinepf.com.au; these rules only fire on the live domain) ---
RewriteCond %{HTTP_HOST} ^www\.pricelinepacificfair\.com\.au$ [NC]
RewriteRule ^(.*)$ https://pricelinepacificfair.com.au/$1 [R=301,L]
# pricelinepacificfair.com (and www.) -> the .com.au site. Needs the .com added as an alias domain in cPanel.
RewriteCond %{HTTP_HOST} ^(www\.)?pricelinepacificfair\.com$ [NC]
RewriteRule ^(.*)$ https://pricelinepacificfair.com.au/$1 [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^pricelinepacificfair\.com\.au$ [NC]
RewriteRule ^(.*)$ https://pricelinepacificfair.com.au/$1 [R=301,L]

# --- Retired pages (301 to the best replacement) ---
RewriteRule ^audiology-services/?$ /pharmacy-services/ [R=301,L]
RewriteRule ^book-a-hormonal-contraceptive-pill-appointment/?$ /hormonal-contraceptive-pill/ [R=301,L]
# Old WordPress slugs still in Google's index (Search Console 404 report, 9 Oct 2026)
RewriteRule ^ear-nose-piercing/?$ /ear-piercings/ [R=301,L]
RewriteRule ^vaccination-2/?$ /vaccination-information/ [R=301,L]

# --- WordPress leftovers: taxonomy, feeds, author, paging, search, attachments ---
RewriteRule ^tag/.*$ /health-blog/ [R=301,L]
RewriteRule ^author/.*$ /about-us/ [R=301,L]
RewriteRule ^category/(health-advice|skincare-beauty|prescriptions|vaccinations|travel|local-guides)/?$ - [L]
RewriteRule ^category/.*$ /health-blog/ [R=301,L]
RewriteRule ^(.+)/feed/?$ /rss.xml [R=301,L]
RewriteRule ^feed/?$ /rss.xml [R=301,L]
RewriteRule ^comments/feed/?$ /rss.xml [R=301,L]
RewriteRule ^page/[0-9]+/?$ /health-blog/ [R=301,L]
RewriteRule ^(.+)/page/[0-9]+/?$ /$1/ [R=301,L]
RewriteCond %{QUERY_STRING} ^s=(.*)$
RewriteRule ^/?$ /search/?q=%1 [R=301,L]
RewriteCond %{QUERY_STRING} ^p=[0-9]+$
RewriteRule ^/?$ /? [R=301,L]
# Wordfence live-traffic links (?wordfence_lh=1&hid=...) crawled from the old site: drop the query string
RewriteCond %{QUERY_STRING} (^|&)wordfence_lh=
RewriteRule ^(.*)$ /$1? [R=301,L]
RewriteRule ^(wp-sitemap.*|sitemap\.xml|sitemap_index\.xml|post-sitemap\.xml|page-sitemap\.xml)$ /sitemap-index.xml [R=301,L]

# --- WordPress system paths: gone for good ---
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|wp-json|xmlrpc\.php|wp-cron\.php|wp-comments-post\.php|wp-trackback\.php)(/.*)?$ - [G,L]

# --- Trailing slash: /prescriptions -> /prescriptions/ (directories only; skip real files) ---
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# Pagefind search index and assets are real files; nothing else to rewrite.
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
# Hashed build assets can be cached for a year; HTML stays fresh
<FilesMatch "\.(avif|webp|png|jpe?g|gif|svg|ico|woff2?|css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "public, max-age=600, must-revalidate"
</FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/rss+xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/javascript application/json application/rss+xml image/svg+xml
</IfModule>

# --- MIME types ---
<IfModule mod_mime.c>
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
</IfModule>
